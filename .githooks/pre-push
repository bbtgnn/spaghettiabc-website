#!/bin/sh
# pre-push: schema:test, schema:rehearse, typecheck — only when the pushed range touches relevant paths.
# Installed by `npm install` / `npm run prepare` (git config core.hooksPath .githooks).
# Escape hatch for the slow rehearsal: SKIP_SCHEMA_REHEARSE=1 git push   (CI still enforces)
# Bypass everything: git push --no-verify

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

zero=0000000000000000000000000000000000000000
pattern='^(seed/seed\.json|schema/|scripts/schema/|src/|package\.json$|package-lock\.json$|astro\.config\.mjs$|emdash-env\.d\.ts$)'
relevant=""

# stdin: <local ref> <local sha> <remote ref> <remote sha> per pushed ref.
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # branch deletion
	if [ "$remote_sha" = "$zero" ]; then
		# New remote branch: compare against the merge-base with origin/main (fallback: treat as relevant).
		base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
	else
		base="$remote_sha"
	fi
	if [ -z "$base" ] || ! files=$(git diff --name-only --no-renames "$base" "$local_sha" 2>/dev/null); then
		relevant="unknown range"
		break
	fi
	if printf '%s\n' "$files" | grep -Eq "$pattern"; then
		relevant="$local_ref"
		break
	fi
done

if [ -z "$relevant" ]; then
	exit 0
fi

if ! command -v npm >/dev/null 2>&1; then
	echo "pre-push: npm not found on PATH; skipping schema guards (CI will enforce)." >&2
	exit 0
fi

fail() {
	echo "" >&2
	echo "pre-push: $1 failed (exit $2). Push blocked." >&2
	echo "  Bypass (CI still enforces): git push --no-verify" >&2
	exit "$2"
}

echo "pre-push: schema-relevant changes in $relevant" >&2

echo "pre-push: [1/3] schema:test" >&2
npm run -s schema:test </dev/null || fail "schema:test" $?

if [ "${SKIP_SCHEMA_REHEARSE:-}" = "1" ]; then
	echo "" >&2
	echo "################################################################" >&2
	echo "# WARNING: SKIP_SCHEMA_REHEARSE=1 — schema:rehearse SKIPPED.   #" >&2
	echo "# The migration chain was NOT replayed against a throwaway     #" >&2
	echo "# server. CI will still run it and block the PR/deploy.        #" >&2
	echo "################################################################" >&2
	echo "" >&2
else
	echo "pre-push: [2/3] schema:rehearse" >&2
	npm run -s schema:rehearse </dev/null || fail "schema:rehearse" $?
fi

echo "pre-push: [3/3] typecheck" >&2
npm run -s typecheck </dev/null || fail "typecheck" $?

echo "pre-push: ok" >&2
exit 0
