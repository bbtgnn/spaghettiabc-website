{
  "name": "spaghettiabc-website",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Spaghetti ABC",
    "seed": "seed/seed.json"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "prebuild": "npm run sync:locale-pages",
    "sync:locale-pages": "node scripts/sync-locale-pages.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:workerd": "node scripts/check-workerd.mjs",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check",
    "seed": "emdash seed seed/seed.json --on-conflict=update",
    "wipe:local": "node scripts/wipe-local.mjs",
    "migrate:status": "emdash migrate --status --wrangler-config wrangler.jsonc",
    "migrate": "emdash migrate --wrangler-config wrangler.jsonc",
    "migrate:check": "emdash migrate --check --wrangler-config wrangler.jsonc",
    "schema:check": "node scripts/schema/check.mjs",
    "schema:generate": "node scripts/schema/generate.mjs",
    "schema:test": "node --test \"scripts/schema/test/*.test.mjs\"",
    "schema:apply": "node scripts/schema/apply.mjs",
    "schema:verify": "node scripts/schema/verify.mjs",
    "schema:pull": "node scripts/schema/pull.mjs",
    "schema:drift": "node scripts/schema/drift.mjs",
    "schema:rehearse": "node scripts/schema/rehearse.mjs",
    "test:google-reviews": "npm run test --prefix plugins/google-reviews",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/node": "^11.1.14",
    "@astrojs/react": "^7.1.9",
    "@emdash-cms/cloudflare": "^1.6.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/tsukimi-rounded": "^5.3.0",
    "@lucide/astro": "^1.80.0",
    "@spaghettiabc/form-headings": "file:./plugins/form-headings",
    "@spaghettiabc/google-reviews": "file:./plugins/google-reviews",
    "@spaghettiabc/layout-consigliato": "file:./plugins/layout-consigliato",
    "animejs": "^4.5.0",
    "astro": "^7.4.13",
    "emdash": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "wrangler": "^4.168.0"
  }
}
