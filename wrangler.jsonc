{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spaghettiabc-staging",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-11-25",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "spaghettiabc-staging"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "spaghettiabc-staging-media"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }]
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" }
	},
	"triggers": {
		"crons": ["* * * * *"]
	},
	"images": {
		"binding": "IMAGES"
	}
}
