{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spaghettiabc-staging",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-11-25",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "spaghettiabc-staging",
			"database_id": "9e31e1ba-bccd-4222-8fc8-ab40e327eb61"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "spaghettiabc-staging-media"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "d30d896b9e2b4b22bfd270bd524d1ca2"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }]
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" }
	},
	"triggers": {
		"crons": ["* * * * *"]
	},
	"images": {
		"binding": "IMAGES"
	}
}
