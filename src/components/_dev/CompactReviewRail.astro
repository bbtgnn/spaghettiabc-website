---
import { Image } from "emdash/ui";
import Star from "@lucide/astro/icons/star";

interface Review {
	author: string;
	quote: string;
	rating?: number | null;
	avatar?: {
		id: string;
		src?: string;
		alt?: string;
		width?: number;
		height?: number;
	} | null;
	review_url?: string | null;
}

interface Props {
	reviews: Review[];
	googleScore?: number;
	googleReviewCount?: number;
	googleProfileUrl?: string | null;
	/** Slightly quieter chrome when nestled inside variant B */
	integrated?: boolean;
	/** No card chrome — sits on the section canvas (variant D) */
	flat?: boolean;
}

const {
	reviews,
	googleScore = 0,
	googleReviewCount = 0,
	googleProfileUrl = null,
	integrated = false,
	flat = false,
} = Astro.props;
const starSlots = [1, 2, 3, 4, 5] as const;
const hasScore = googleScore > 0 || Boolean(googleProfileUrl);
const show = hasScore || reviews.length > 0;
---

{
	show && (
		<div
			class:list={[
				"pg-review-rail",
				integrated && "pg-review-rail--integrated",
				flat && "pg-review-rail--flat",
			]}
		>
			{integrated && (
				<p class="label pg-review-rail__label">Recensioni</p>
			)}
			<div class="pg-review-rail__row">
				{hasScore && (
					<aside class="pg-google-score">
						{googleScore > 0 && (
							<p class="pg-google-score__value">{googleScore.toFixed(1)}</p>
						)}
						{googleScore > 0 && (
							<div
								class="star-row pg-google-score__stars"
								aria-label={`Valutazione media: ${googleScore.toFixed(1)} su 5`}
							>
								{starSlots.map((n) => (
									<Star
										class={`star-row__icon${n <= Math.round(googleScore) ? " is-filled" : ""}`}
										size={12}
										stroke-width={1.5}
										aria-hidden="true"
									/>
								))}
							</div>
						)}
						{googleReviewCount > 0 && (
							<p class="mono pg-google-score__count">
								{googleReviewCount} recensioni su Google
							</p>
						)}
						{googleProfileUrl && (
							<a
								class="pg-google-score__link"
								href={googleProfileUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Vedi su Google
							</a>
						)}
					</aside>
				)}

				{reviews.length > 0 && (
					<div
						class="pg-review-rail__track"
						role="list"
						aria-label="Recensioni Google"
					>
						{reviews.map((item) => {
							const rating = Math.min(5, Math.max(0, Number(item.rating) || 5));
							const CardTag = item.review_url ? "a" : "div";
							const cardProps = item.review_url
								? {
										href: item.review_url,
										target: "_blank",
										rel: "noopener noreferrer",
									}
								: {};
							return (
								<div class="pg-review-rail__item" role="listitem">
									<CardTag
										class:list={["pg-review-card", flat && "pg-review-card--flat"]}
										{...cardProps}
									>
										<div
											class="star-row pg-review-card__stars"
											aria-label={`Valutazione: ${rating} su 5`}
										>
											{starSlots.map((n) => (
												<Star
													class={`star-row__icon${n <= rating ? " is-filled" : ""}`}
													size={12}
													stroke-width={1.5}
													aria-hidden="true"
												/>
											))}
										</div>
										<blockquote class="pg-review-card__quote">
											<p>{item.quote}</p>
										</blockquote>
										<div class="pg-review-card__author">
											{item.avatar && (
												<span class="pg-review-card__avatar">
													<Image image={item.avatar} />
												</span>
											)}
											<span class="pg-review-card__name">{item.author}</span>
										</div>
									</CardTag>
								</div>
							);
						})}
					</div>
				)}
			</div>
		</div>
	)
}
