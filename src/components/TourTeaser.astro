---
import { Image } from "emdash/ui";

interface Props {
	href: string;
	title: string;
	excerpt?: string | null;
	destination?: string | null;
	duration?: string | null;
	price?: string | null;
	image?: {
		id: string;
		src?: string;
		alt?: string;
		width?: number;
		height?: number;
	} | null;
	edit?: {
		title?: Record<string, unknown>;
		excerpt?: Record<string, unknown>;
		featured_image?: Record<string, unknown>;
	};
	index?: number;
}

const {
	href,
	title,
	excerpt,
	destination,
	duration,
	price,
	image,
	edit,
	index = 0,
} = Astro.props;

const indexLabel = String(index + 1).padStart(2, "0");
const meta = [destination, duration].filter(Boolean).join(" · ");
---

<article
	class="tour-teaser"
	data-reveal
	style={`--reveal-delay: ${index * 110}ms`}
>
	<a class="tour-teaser__link" href={href}>
		{
			image && (
				<div class="tour-teaser__media" data-reveal="mask" {...edit?.featured_image}>
					<div>
						<Image image={image} />
					</div>
				</div>
			)
		}
		<div class="tour-teaser__meta-row">
			<span class="mono tour-teaser__index">{indexLabel}</span>
			{meta && <p class="label tour-teaser__meta">{meta}</p>}
		</div>
		<h3 class="type-h3 tour-teaser__title" {...edit?.title}>{title}</h3>
		{
			excerpt && (
				<p class="type-body tour-teaser__excerpt" {...edit?.excerpt}>
					{excerpt}
				</p>
			)
		}
		{
			price && (
				<p class="mono tour-teaser__price">{price}</p>
			)
		}
	</a>
</article>

<style>
	.tour-teaser__link {
		display: grid;
		gap: 0.85rem;
		text-decoration: none;
		color: inherit;
	}

	.tour-teaser__media {
		overflow: hidden;
		background: var(--surface);
	}

	.tour-teaser__media :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: transform 1100ms var(--ease-out-expo);
	}

	.tour-teaser__link:hover .tour-teaser__media :global(img) {
		transform: scale(1.04);
	}

	.tour-teaser__meta-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.85rem;
		border-top: 1px solid var(--line);
		transition: border-color 280ms ease;
	}

	.tour-teaser__link:hover .tour-teaser__meta-row {
		border-top-color: var(--accent);
	}

	.tour-teaser__index {
		font-size: 0.6875rem;
		color: var(--muted);
	}

	.tour-teaser__title {
		margin: 0;
	}

	.tour-teaser__excerpt {
		max-width: 34rem;
		font-size: 0.9375rem;
	}

	.tour-teaser__price {
		font-size: 0.8125rem;
		color: var(--ink);
	}
</style>
