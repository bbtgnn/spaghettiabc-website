---
import { Image } from "emdash/ui";

interface Props {
	href: string;
	title: string;
	excerpt?: string | null;
	destination?: string | null;
	duration?: string | null;
	price?: string | null;
	image?: {
		id: string;
		src?: string;
		alt?: string;
		width?: number;
		height?: number;
	} | null;
	edit?: {
		title?: Record<string, unknown>;
		excerpt?: Record<string, unknown>;
		featured_image?: Record<string, unknown>;
	};
	index?: number;
}

const {
	href,
	title,
	excerpt,
	destination,
	duration,
	price,
	image,
	edit,
	index = 0,
} = Astro.props;

const indexLabel = String(index + 1).padStart(2, "0");
const meta = [destination, duration].filter(Boolean).join(" · ");
---

<article
	class="tour-teaser"
	data-reveal
	style={`--reveal-delay: ${(index % 3) * 70}ms`}
>
	<a class="tour-teaser__link" href={href}>
		{
			image && (
				<div class="tour-teaser__media" {...edit?.featured_image}>
					<Image
						image={image}
						loading={index < 3 ? "eager" : "lazy"}
						priority={index < 3}
					/>
				</div>
			)
		}
		<div class="tour-teaser__meta-row">
			<span class="mono tour-teaser__index">{indexLabel}</span>
			{meta && <p class="label tour-teaser__meta">{meta}</p>}
		</div>
		<h3 class="type-h3 tour-teaser__title" {...edit?.title}>{title}</h3>
		{
			excerpt && (
				<p class="type-body tour-teaser__excerpt" {...edit?.excerpt}>
					{excerpt}
				</p>
			)
		}
		{
			price && (
				<p class="mono tour-teaser__price">{price}</p>
			)
		}
	</a>
</article>

<style>
	.tour-teaser__link {
		display: grid;
		gap: 0.85rem;
		height: 100%;
		padding: 1rem;
		background: color-mix(in oklab, var(--canvas) 45%, white);
		border: 1px solid var(--line);
		text-decoration: none;
		color: inherit;
		transition: border-color 280ms ease;
	}

	.tour-teaser__link:hover,
	.tour-teaser__link:focus-visible {
		border-color: var(--accent);
		outline: none;
	}

	.tour-teaser__media {
		overflow: hidden;
		background: var(--surface);
	}

	.tour-teaser__media :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		opacity: 0;
		transition:
			opacity 480ms ease,
			transform 1100ms var(--ease-out-expo);
	}

	.tour-teaser__media :global(img.is-loaded) {
		opacity: 1;
	}

	.tour-teaser__link:hover .tour-teaser__media :global(img.is-loaded) {
		transform: scale(1.04);
	}

	.tour-teaser__meta-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.tour-teaser__index {
		font-size: 0.6875rem;
		color: var(--muted);
	}

	.tour-teaser__title {
		margin: 0;
	}

	.tour-teaser__excerpt {
		max-width: 34rem;
		font-size: 0.9375rem;
	}

	.tour-teaser__price {
		font-size: 0.8125rem;
		color: var(--ink);
	}
</style>

<script>
	function markLoaded(img: HTMLImageElement) {
		if (img.complete && img.naturalWidth > 0) {
			img.classList.add("is-loaded");
			return;
		}
		img.addEventListener("load", () => img.classList.add("is-loaded"), { once: true });
		img.addEventListener("error", () => img.classList.add("is-loaded"), { once: true });
	}

	function bindTeaserImages(root: ParentNode = document) {
		root.querySelectorAll<HTMLImageElement>(".tour-teaser__media img").forEach(markLoaded);
	}

	bindTeaserImages();
	document.addEventListener("astro:page-load", () => bindTeaserImages());
</script>
