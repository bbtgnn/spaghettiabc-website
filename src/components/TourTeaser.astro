---
import { Image } from "emdash/ui";

interface Props {
	href: string;
	title: string;
	excerpt?: string | null;
	destination?: string | null;
	duration?: string | null;
	price?: string | null;
	image?: {
		id: string;
		src?: string;
		alt?: string;
		width?: number;
		height?: number;
	} | null;
	edit?: {
		title?: Record<string, unknown>;
		excerpt?: Record<string, unknown>;
		featured_image?: Record<string, unknown>;
	};
	index?: number;
}

const {
	href,
	title,
	excerpt,
	destination,
	duration,
	price,
	image,
	edit,
	index = 0,
} = Astro.props;

const meta = [destination, duration, price].filter(Boolean).join(" · ");
---

<article class="tour-teaser" style={`--i: ${index}`}>
	<a class="tour-teaser__link" href={href}>
		{
			image && (
				<div class="tour-teaser__media" {...edit?.featured_image}>
					<Image image={image} />
				</div>
			)
		}
		<div class="tour-teaser__body">
			{meta && <p class="tour-teaser__meta">{meta}</p>}
			<h3 class="tour-teaser__title" {...edit?.title}>{title}</h3>
			{
				excerpt && (
					<p class="tour-teaser__excerpt" {...edit?.excerpt}>
						{excerpt}
					</p>
				)
			}
			<span class="tour-teaser__cta">Scopri il tour</span>
		</div>
	</a>
</article>

<style>
	.tour-teaser {
		animation: rise-in 700ms var(--ease-out) both;
		animation-delay: calc(120ms + var(--i) * 90ms);
	}

	.tour-teaser__link {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: var(--space-4);
		align-items: stretch;
		text-decoration: none;
		color: inherit;
	}

	.tour-teaser__media {
		overflow: hidden;
		border-radius: var(--radius);
		min-height: 14rem;
		background: var(--color-foam);
	}

	.tour-teaser__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 4 / 3;
		transition: transform 700ms var(--ease-out);
	}

	.tour-teaser__link:hover .tour-teaser__media :global(img) {
		transform: scale(1.04);
	}

	.tour-teaser__body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-2);
		padding-block: var(--space-2);
	}

	.tour-teaser__meta {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-sea);
	}

	.tour-teaser__title {
		font-size: var(--text-xl);
	}

	.tour-teaser__excerpt {
		max-width: 34rem;
		color: var(--color-ink-soft);
	}

	.tour-teaser__cta {
		margin-top: var(--space-2);
		font-size: var(--text-sm);
		font-weight: 650;
		color: var(--color-sea-deep);
		text-decoration: underline;
		text-underline-offset: 0.28em;
		text-decoration-thickness: 1px;
	}

	@media (max-width: 800px) {
		.tour-teaser__link {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}

		.tour-teaser__media {
			min-height: 0;
		}
	}
</style>
