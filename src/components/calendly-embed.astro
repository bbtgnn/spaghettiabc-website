---
import { resolveLocale, t } from "../i18n/utils";

interface Props {
	url: string;
	id?: string;
	locale?: string;
}

const { url, id, locale: localeProp } = Astro.props;
const locale = resolveLocale(localeProp ?? Astro.currentLocale);
const buttonText = t(locale, "calendlyButtonText");
const iframeTitle = t(locale, "calendlyIframeTitle");
const loadingLabel = t(locale, "calendlyLoading");

/**
 * SSR fallback only — client boot overwrites from live `--accent` / `--ink`.
 * Hex without #. https://calendly.com/help/how-to-customize-your-embed
 */
const CALENDLY_TEXT_COLOR = "101010";
const CALENDLY_PRIMARY_COLOR = "c43c2c";

/**
 * Event-type + landing/team hide flags so either URL shape drops chrome details.
 * Colors are refreshed from CSS tokens on the client before initInlineWidget.
 * https://calendly.com/help/how-to-customize-your-embed
 */
function withCalendlyEmbedParams(raw: string, label: string): string {
	try {
		const parsed = new URL(raw);
		parsed.searchParams.set("hide_event_type_details", "1");
		parsed.searchParams.set("hide_landing_page_details", "1");
		parsed.searchParams.set("hide_gdpr_banner", "1");
		parsed.searchParams.set("text_color", CALENDLY_TEXT_COLOR);
		parsed.searchParams.set("primary_color", CALENDLY_PRIMARY_COLOR);
		parsed.searchParams.set("button_text", label);
		return parsed.toString();
	} catch {
		return raw;
	}
}

const embedUrl = withCalendlyEmbedParams(url, buttonText);
---

<!--
  Progressive enhancement host (#24):
  - No-JS: real SSR iframe (fixed ~700px; inner scroll OK).
  - With JS: keep iframe until widget.js ready, then calendly-embed.ts swaps to
    Calendly.initInlineWidget (resize:false) + height/phase/animejs behaviour.
-->
<div
	id={id}
	class="calendly-embed"
	data-calendly-embed
	data-url={embedUrl}
	style="min-width:320px;height:700px;"
>
	<iframe
		class="calendly-embed__ssr"
		data-calendly-ssr
		src={embedUrl}
		title={iframeTitle}
		loading="lazy"
		referrerpolicy="no-referrer-when-downgrade"
	></iframe>
	<div
		class="calendly-embed__spinner"
		data-calendly-spinner
		role="status"
		hidden
		aria-hidden="true"
	>
		<span class="calendly-embed__spinner-ring" aria-hidden="true"></span>
		<span class="calendly-embed__spinner-label">{loadingLabel}</span>
	</div>
</div>

<style>
	.calendly-embed {
		position: relative;
		width: 100%;
		min-width: 320px;
		height: 700px;
		overflow: hidden;
		background: #fff;
	}

	.calendly-embed :global(iframe) {
		width: 100%;
		height: 100%;
		min-width: 320px;
		border: 0;
		overflow: hidden;
		/* No-JS / pre-enhance: iframe must stay interactive. */
		pointer-events: auto;
	}

	/* During widget enhance, lock interaction until height reveal. */
	.calendly-embed.is-enhancing:not(.is-ready) :global(iframe) {
		pointer-events: none;
	}

	.calendly-embed.is-ready :global(iframe) {
		pointer-events: auto;
	}

	/* Prefer our spinner; Calendly injects its own bounce dots. */
	.calendly-embed :global(.calendly-spinner) {
		display: none !important;
	}

	.calendly-embed :global(.calendly-embed__spinner) {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 0.75rem;
		margin: 0;
		background: #fff;
		pointer-events: none;
	}

	.calendly-embed :global(.calendly-embed__spinner[hidden]) {
		display: none;
	}

	.calendly-embed :global(.calendly-embed__spinner-ring) {
		box-sizing: border-box;
		width: 1.375rem;
		height: 1.375rem;
		border: 1.5px solid color-mix(in oklab, var(--ink) 14%, transparent);
		border-top-color: var(--accent);
		border-radius: 50%;
	}

	@media (prefers-reduced-motion: no-preference) {
		.calendly-embed :global(.calendly-embed__spinner-ring) {
			animation: calendly-embed-spin 0.75s linear infinite;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.calendly-embed :global(.calendly-embed__spinner-ring) {
			border-color: color-mix(in oklab, var(--ink) 14%, transparent);
			border-top-color: var(--title);
		}
	}

	@keyframes calendly-embed-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.calendly-embed :global(.calendly-embed__spinner-label) {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	import "../scripts/calendly-embed.ts";
</script>
