---
/**
 * PROTOTYPE-only floating bar for Scheda Tour hero compare.
 * Hidden when not import.meta.env.DEV. Cycles ?variant= via history.replaceState + reload.
 */
interface Variant {
	key: string;
	label: string;
}

interface Props {
	variants: Variant[];
	current: string;
	param?: string;
}

const { variants, current, param = "variant" } = Astro.props;
const isDev = import.meta.env.DEV;
---

{
	isDev && (
		<div
			class="proto-switcher"
			role="region"
			aria-label="Prototype layout switcher"
			data-proto-switcher
			data-param={param}
			data-current={current}
			data-variants={JSON.stringify(variants)}
		>
			<button type="button" class="proto-switcher__btn" data-proto-prev aria-label="Previous variant">
				←
			</button>
			<p class="proto-switcher__label" data-proto-label>
				{current} ({variants.find((v) => v.key === current)?.label ?? current})
			</p>
			<button type="button" class="proto-switcher__btn" data-proto-next aria-label="Next variant">
				→
			</button>
		</div>
	)
}

{
	isDev && (
		<style>
			.proto-switcher {
				position: fixed;
				z-index: 9999;
				left: 50%;
				bottom: 1.25rem;
				transform: translateX(-50%);
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.5rem 0.75rem;
				border: 1px solid #111;
				background: #111;
				color: #f5f5f5;
				font-family: ui-monospace, monospace;
				font-size: 0.75rem;
				letter-spacing: 0.02em;
				box-shadow: 0 8px 24px rgb(0 0 0 / 0.28);
			}

			.proto-switcher__btn {
				border: 0;
				background: transparent;
				color: inherit;
				cursor: pointer;
				padding: 0.25rem 0.4rem;
				font: inherit;
			}

			.proto-switcher__btn:hover {
				background: #333;
			}

			.proto-switcher__label {
				margin: 0;
				min-width: 14rem;
				text-align: center;
				white-space: nowrap;
			}
		</style>
		<script is:inline>
			(() => {
				const root = document.querySelector("[data-proto-switcher]");
				if (!(root instanceof HTMLElement)) return;

				const param = root.dataset.param || "variant";
				/** @type {{ key: string; label: string }[]} */
				let variants = [];
				try {
					variants = JSON.parse(root.dataset.variants || "[]");
				} catch {
					return;
				}
				if (!variants.length) return;

				const keys = variants.map((v) => v.key);
				let index = Math.max(0, keys.indexOf(root.dataset.current || keys[0]));

				function go(nextIndex) {
					index = (nextIndex + keys.length) % keys.length;
					const url = new URL(window.location.href);
					url.searchParams.set(param, keys[index]);
					window.location.href = url.toString();
				}

				root.querySelector("[data-proto-prev]")?.addEventListener("click", () =>
					go(index - 1),
				);
				root.querySelector("[data-proto-next]")?.addEventListener("click", () =>
					go(index + 1),
				);

				window.addEventListener("keydown", (event) => {
					const t = event.target;
					if (
						t instanceof HTMLElement &&
						(t.closest("input, textarea, select, [contenteditable=true]") ||
							t.isContentEditable)
					) {
						return;
					}
					if (event.key === "ArrowLeft") {
						event.preventDefault();
						go(index - 1);
					}
					if (event.key === "ArrowRight") {
						event.preventDefault();
						go(index + 1);
					}
				});
			})();
		</script>
	)
}
