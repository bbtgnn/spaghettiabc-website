---
/**
 * VARIANT A — current Scheda Tour hero (Atelier product-split).
 * Gallery left + sticky info right, with Calendly Prenotazione in the info column
 * when `calendlyUrl` is set. Breadcrumb through gallery|info split.
 */
import { Image } from "emdash/ui";
import CalendlyEmbed from "../CalendlyEmbed.astro";

/** EmDash image field shape (same as featured_image). */
type TourImage = {
	id: string;
	src?: string;
	alt?: string;
	caption?: string;
	width?: number;
	height?: number;
	filename?: string;
	mimeType?: string;
	blurhash?: string;
	dominantColor?: string;
	focalX?: number;
	focalY?: number;
	provider?: string;
	previewUrl?: string;
	meta?: Record<string, unknown>;
};

interface Props {
	title: string;
	destination?: string | null;
	price?: string | null;
	excerpt?: string | null;
	galleryImages: TourImage[];
	specs: Array<{
		term: string;
		value: string;
		edit?: Record<string, unknown>;
	}>;
	/** Empty string = no Prenotazione panel. */
	calendlyUrl: string;
	edit: {
		title?: Record<string, unknown>;
		destination?: Record<string, unknown>;
		price?: Record<string, unknown>;
		excerpt?: Record<string, unknown>;
		featured_image?: Record<string, unknown>;
		calendly_url?: Record<string, unknown>;
	};
}

const {
	title,
	destination,
	price,
	excerpt,
	galleryImages,
	specs,
	calendlyUrl,
	edit,
} = Astro.props;

const hasPrenota = Boolean(calendlyUrl);
---

<!-- VARIANT A: Atelier product-split Scheda Tour hero -->
<nav class="mono scheda-tour__crumb" aria-label="Breadcrumb">
	<a href="/tours" class="link">Catalogo tour</a>
	<span aria-hidden="true">/</span>
	<span class="scheda-tour__crumb-current" aria-current="page">{title}</span>
</nav>

<div class="scheda-tour__split">
	{
		galleryImages.length > 0 && (
			<section
				class="scheda-tour__gallery"
				aria-label={`${title} images`}
				data-tour-gallery
			>
				<div class="scheda-tour__stage" {...edit.featured_image}>
					{galleryImages.map((image, index) => (
						<div
							class:list={["gallery-panel", index !== 0 && "is-hidden"]}
							data-gallery-panel={index}
						>
							<Image image={image} />
						</div>
					))}
				</div>

				{galleryImages.length >= 2 && (
					<div
						class="scheda-tour__thumbs"
						role="group"
						aria-label="Choose an image"
					>
						{galleryImages.map((image, index) => (
							<button
								type="button"
								class="gallery-thumb"
								data-gallery-thumb={index}
								aria-label={`Show view ${index + 1}`}
								aria-pressed={index === 0 ? "true" : "false"}
							>
								<Image image={image} />
							</button>
						))}
					</div>
				)}
			</section>
		)
	}

	<div class="scheda-tour__info">
		{
			destination && (
				<p class="label" {...edit.destination}>
					{destination}
				</p>
			)
		}
		<h1 class="type-h2 scheda-tour__title" {...edit.title}>{title}</h1>
		{
			price && (
				<p class="mono scheda-tour__price" {...edit.price}>
					{price}
				</p>
			)
		}

		{
			excerpt && (
				<p class="type-body scheda-tour__excerpt" {...edit.excerpt}>
					{excerpt}
				</p>
			)
		}

		{
			specs.length > 0 && (
				<dl class="mono scheda-tour__specs">
					{specs.map(({ term, value, edit: specEdit }) => (
						<div class="scheda-tour__spec" {...specEdit}>
							<dt>{term}</dt>
							<dd>{value}</dd>
						</div>
					))}
				</dl>
			)
		}

		{
			hasPrenota && (
				<section
					id="prenota-calendly"
					class="scheda-tour__prenota-panel"
					aria-labelledby="prenota-heading"
					{...edit.calendly_url}
				>
					<h2 id="prenota-heading" class="label scheda-tour__prenota-heading">
						Prenota
					</h2>
					<CalendlyEmbed url={calendlyUrl} />
				</section>
			)
		}
	</div>
</div>

<style>
	.scheda-tour__crumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-block: 1.5rem;
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--muted);
	}

	.scheda-tour__crumb-current {
		color: var(--ink);
	}

	.scheda-tour__split {
		display: grid;
		align-items: start;
		gap: 2.5rem;
		border-top: 1px solid var(--line);
		padding-top: 2rem;
	}

	@media (min-width: 1024px) {
		.scheda-tour__split {
			grid-template-columns: 7fr 5fr;
			gap: 3rem;
		}
	}

	.scheda-tour__stage {
		position: relative;
		overflow: hidden;
		background: var(--surface);
	}

	.scheda-tour__stage :global(img) {
		aspect-ratio: 4 / 5;
		width: 100%;
		object-fit: cover;
		display: block;
	}

	.scheda-tour__thumbs {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.gallery-thumb {
		overflow: hidden;
		padding: 0;
		border: 0;
		background: var(--surface);
		cursor: pointer;
		box-shadow: inset 0 0 0 1px var(--line);
		transition: box-shadow 260ms ease;
	}

	.gallery-thumb:hover {
		box-shadow: inset 0 0 0 1px var(--line-strong);
	}

	.gallery-thumb[aria-pressed="true"] {
		box-shadow: inset 0 0 0 2px var(--accent);
	}

	.gallery-thumb :global(img) {
		aspect-ratio: 1;
		width: 100%;
		object-fit: cover;
		display: block;
	}

	.gallery-panel.is-hidden {
		display: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.gallery-panel:not(.is-hidden) {
			animation: panel-in 600ms var(--ease-out-expo) both;
		}

		@keyframes panel-in {
			from {
				opacity: 0;
				transform: scale(1.015);
			}
		}
	}

	.scheda-tour__info {
		display: grid;
		justify-items: start;
		align-content: start;
	}

	@media (min-width: 1024px) {
		.scheda-tour__info {
			position: sticky;
			top: 7rem;
		}
	}

	.scheda-tour__title {
		margin-top: 1.25rem;
	}

	.scheda-tour__price {
		margin-top: 1.25rem;
		font-size: 1.25rem;
		color: var(--ink);
	}

	.scheda-tour__excerpt {
		margin-top: 2rem;
		max-width: 46ch;
	}

	.scheda-tour__specs {
		width: 100%;
		margin-top: 2.5rem;
		border-top: 1px solid var(--line);
		font-size: 0.8125rem;
	}

	.scheda-tour__spec {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		border-bottom: 1px solid var(--line);
		padding-block: 0.75rem;
	}

	.scheda-tour__spec dt {
		color: var(--muted);
	}

	.scheda-tour__spec dd {
		margin: 0;
		text-align: right;
		color: var(--ink);
	}

	.scheda-tour__prenota-panel {
		width: 100%;
		margin-top: 2.5rem;
		border-top: 1px solid var(--line);
		padding-top: 1.5rem;
	}

	.scheda-tour__prenota-heading {
		margin: 0 0 1rem;
	}
</style>

<script is:inline>
	(() => {
		const gallery = document.querySelector("[data-tour-gallery]");
		if (!gallery) return;

		const panels = Array.from(
			gallery.querySelectorAll("[data-gallery-panel]"),
		);
		const thumbs = Array.from(
			gallery.querySelectorAll("[data-gallery-thumb]"),
		);

		thumbs.forEach((thumb) => {
			thumb.addEventListener("click", () => {
				const active = thumb.dataset.galleryThumb;
				panels.forEach((panel) =>
					panel.classList.toggle(
						"is-hidden",
						panel.dataset.galleryPanel !== active,
					),
				);
				thumbs.forEach((button) => {
					button.setAttribute(
						"aria-pressed",
						String(button === thumb),
					);
				});
			});
		});
	})();
</script>
