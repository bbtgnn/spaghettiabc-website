---
/**
 * PROTOTYPE variant for ?variant= compare on Scheda Tour.
 * VARIANT B — responsive: desktop full left|iframe; tablet hero then data+editorial|iframe;
 * mobile hero → data → iframe → editorial/FAQ.
 */
import { Image } from "emdash/ui";
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import CalendlyEmbed from "../CalendlyEmbed.astro";

/** EmDash image field shape (same as featured_image / Variant A). */
type TourImage = {
	id: string;
	src?: string;
	alt?: string;
	caption?: string;
	width?: number;
	height?: number;
	filename?: string;
	mimeType?: string;
	blurhash?: string;
	dominantColor?: string;
	focalX?: number;
	focalY?: number;
	provider?: string;
	previewUrl?: string;
	meta?: Record<string, unknown>;
};

interface Props {
	title: string;
	destination?: string | null;
	price?: string | null;
	excerpt?: string | null;
	galleryImages: TourImage[];
	specs: Array<{
		term: string;
		value: string;
		edit?: Record<string, unknown>;
	}>;
	/** Empty string = muted empty state (no embed). */
	calendlyUrl: string;
	edit: {
		title?: Record<string, unknown>;
		destination?: Record<string, unknown>;
		price?: Record<string, unknown>;
		excerpt?: Record<string, unknown>;
		featured_image?: Record<string, unknown>;
		calendly_url?: Record<string, unknown>;
	};
}

const {
	title,
	excerpt,
	galleryImages,
	specs,
	calendlyUrl,
	edit,
} = Astro.props;

const hasPrenota = Boolean(calendlyUrl);
const leadImage = galleryImages[0];
const extraImages = galleryImages.slice(1);
---

<section class="sth-prenota" aria-label={title}>
	<div class="sth-prenota__layout">
		{/* Hero: image as background; title + subtitle centered */}
		<div
			class="sth-prenota__intro"
			data-tour-gallery={leadImage ? true : undefined}
		>
			<div
				class:list={[
					"sth-prenota__stage",
					!leadImage && "sth-prenota__stage--empty",
				]}
				{...(leadImage ? edit.featured_image : {})}
			>
				{
					leadImage && (
						<div class="sth-prenota__media" aria-hidden="true">
							{galleryImages.map((image, index) => (
								<div
									class:list={[
										"gallery-panel",
										index !== 0 && "is-hidden",
									]}
									data-gallery-panel={index}
								>
									<Image image={image} />
								</div>
							))}
						</div>
					)
				}
				<div class="sth-prenota__scrim" aria-hidden="true"></div>

				<nav class="sth-prenota__back" aria-label="Breadcrumb">
					<a class="btn btn-outline btn--arrow btn--sm" href="/tours">
						<ArrowLeft class="btn__icon" size={14} stroke-width={1.75} aria-hidden="true" />
						<span class="btn__label">Catalogo tour</span>
					</a>
				</nav>

				<div class="sth-prenota__copy">
					<h1 class="sth-prenota__title" {...edit.title}>{title}</h1>
					{
						excerpt && (
							<p class="type-body sth-prenota__excerpt" {...edit.excerpt}>
								{excerpt}
							</p>
						)
					}
				</div>
			</div>

			{
				extraImages.length > 0 && (
					<div
						class="sth-prenota__thumbs"
						role="group"
						aria-label="Choose an image"
					>
						{galleryImages.map((image, index) => (
							<button
								type="button"
								class="gallery-thumb"
								data-gallery-thumb={index}
								aria-label={`Show view ${index + 1}`}
								aria-pressed={index === 0 ? "true" : "false"}
							>
								<Image image={image} />
							</button>
						))}
					</div>
				)
			}
		</div>

		{/* Data / specs */}
		{
			specs.length > 0 && (
				<div class="sth-prenota__data">
					<dl class="mono sth-prenota__specs">
						{specs.map(({ term, value, edit: specEdit }) => (
							<div class="sth-prenota__spec" {...specEdit}>
								<dt>{term}</dt>
								<dd>{value}</dd>
							</div>
						))}
					</dl>
				</div>
			)
		}

		{
			hasPrenota ? (
				<aside
					id="prenota-calendly"
					class="sth-prenota__book"
					aria-label="Prenota"
					{...edit.calendly_url}
				>
					<CalendlyEmbed url={calendlyUrl} />
				</aside>
			) : (
				<aside class="sth-prenota__book sth-prenota__book--empty" aria-live="polite">
					<p class="mono sth-prenota__empty">Prenotazione non disponibile</p>
				</aside>
			)
		}

		{/* Editorial + FAQ (slot from page) */}
		<div class="sth-prenota__body">
			<slot />
		</div>
	</div>
</section>

<style>
	.sth-prenota {
		padding-block: 0;
	}

	/*
	 * Mobile (<768): hero → data → iframe → editorial/FAQ
	 * Tablet / mid (768–1279): hero full-bleed; then data+editorial | iframe
	 * XL desktop (≥1280): full left column (hero+data+editorial) | iframe
	 */
	.sth-prenota__layout {
		display: grid;
		grid-template-areas:
			"intro"
			"data"
			"book"
			"body";
		align-items: start;
		gap: 2.5rem;
		border-top: 1px solid var(--line);
		padding-top: 2rem;
	}

	@media (min-width: 768px) and (max-width: 1279px) {
		.sth-prenota__layout {
			grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
			grid-template-areas:
				"intro intro"
				"data book"
				"body book";
			gap: 2rem;
			justify-content: start;
		}
	}

	@media (min-width: 1280px) {
		.sth-prenota__layout {
			/* Calendly: <650 = small layout; >=650 adds side chrome. */
			grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
			grid-template-areas:
				"intro book"
				"data book"
				"body book";
			gap: 3rem;
			justify-content: start;
		}
	}

	.sth-prenota__intro {
		grid-area: intro;
		display: grid;
		gap: 0.75rem;
		justify-items: stretch;
		align-content: start;
		width: 100%;
		min-width: 0;
	}

	.sth-prenota__stage {
		position: relative;
		display: grid;
		grid-template-areas: "stack";
		align-items: center;
		justify-items: center;
		overflow: hidden;
		isolation: isolate;
		width: 100%;
		/* Taller than the old 4:3 / 22rem lead image */
		min-height: clamp(28rem, 62vh, 40rem);
		border-radius: 0.75rem;
		background: var(--surface-strong);
	}

	.sth-prenota__media,
	.sth-prenota__scrim,
	.sth-prenota__copy {
		grid-area: stack;
	}

	.sth-prenota__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.sth-prenota__media :global(img),
	.sth-prenota__media .gallery-panel {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.sth-prenota__media .gallery-panel {
		position: absolute;
		inset: 0;
	}

	.sth-prenota__scrim {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--ink) 45%, transparent) 0%,
				color-mix(in oklab, var(--ink) 28%, transparent) 42%,
				color-mix(in oklab, var(--ink) 55%, transparent) 100%
			);
		pointer-events: none;
	}

	.sth-prenota__stage--empty .sth-prenota__scrim {
		background: color-mix(in oklab, var(--ink) 18%, var(--surface));
	}

	.sth-prenota__copy {
		position: relative;
		z-index: 2;
		display: grid;
		justify-items: center;
		align-content: center;
		gap: 1rem;
		width: min(100%, 36rem);
		padding: 4.5rem 1.5rem 3rem;
		text-align: center;
	}

	.sth-prenota__data {
		grid-area: data;
		width: 100%;
		max-width: 65ch;
		min-width: 0;
		justify-self: center;
	}

	.sth-prenota__book {
		grid-area: book;
		width: 100%;
		max-width: none;
		justify-self: stretch;
	}

	.sth-prenota__body {
		grid-area: body;
		width: 100%;
		min-width: 0;
	}

	.sth-prenota__book :global(.calendly-embed) {
		margin: 0;
		width: 100%;
		max-width: none;
		overflow: hidden;
		border-radius: 0.75rem;
		border: 1px solid var(--title);
		box-sizing: border-box;
		background: #fff;
	}

	.sth-prenota__book :global(.calendly-embed iframe) {
		display: block;
		width: 100%;
		border: 0;
		border-radius: 0.75rem;
	}

	@media (min-width: 768px) {
		.sth-prenota__book {
			max-width: 400px;
			min-width: 280px;
			justify-self: start;
			position: sticky;
			top: 7rem;
			align-self: start;
		}

		.sth-prenota__book :global(.calendly-embed) {
			max-width: 400px;
		}
	}

	/* Slotted content/FAQ: drop page-level 4rem / --measure; FAQ keeps its own border+padding. */
	.sth-prenota__body:empty {
		display: none;
	}

	.sth-prenota__body :global(.scheda-tour__content),
	.sth-prenota__body :global(.scheda-tour__faq) {
		margin-top: 0;
		margin-inline: auto;
		max-width: 65ch;
	}

	.sth-prenota__back {
		position: absolute;
		top: 1rem;
		left: 1rem;
		z-index: 3;
		display: flex;
		flex-wrap: wrap;
	}

	.sth-prenota__back :global(.btn-outline) {
		color: #fff;
		border-color: color-mix(in oklab, #fff 55%, transparent);
		background: color-mix(in oklab, var(--ink) 28%, transparent);
	}

	.sth-prenota__back :global(.btn-outline:hover),
	.sth-prenota__back :global(.btn-outline:focus-visible) {
		border-color: #fff;
		background: color-mix(in oklab, var(--ink) 42%, transparent);
	}

	.sth-prenota__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.875rem, 4vw, 3rem);
		line-height: 1.12;
		letter-spacing: -0.02em;
		font-weight: var(--font-display-weight);
		color: #fff;
		text-wrap: balance;
	}

	.sth-prenota__excerpt {
		margin: 0;
		width: 100%;
		max-width: 32ch;
		color: color-mix(in oklab, #fff 88%, transparent);
	}

	.sth-prenota__specs {
		width: 100%;
		margin: 0;
		border-top: 1px solid var(--line);
		font-size: 0.8125rem;
	}

	/* On XL desktop, specs sit under intro in the same column — keep separation. */
	@media (min-width: 1280px) {
		.sth-prenota__specs {
			margin-top: 0;
		}
	}

	.sth-prenota__spec {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		border-bottom: 1px solid var(--line);
		padding-block: 0.75rem;
	}

	.sth-prenota__spec dt {
		color: var(--muted);
	}

	.sth-prenota__spec dd {
		margin: 0;
		text-align: right;
		color: var(--ink);
	}

	.sth-prenota__book--empty {
		display: flex;
		align-items: flex-start;
		padding-top: 0.25rem;
	}

	.sth-prenota__empty {
		margin: 0;
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--muted);
	}

	.sth-prenota__thumbs {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		width: 100%;
	}

	.gallery-thumb {
		overflow: hidden;
		padding: 0;
		border: 0;
		background: var(--surface);
		cursor: pointer;
		box-shadow: inset 0 0 0 1px var(--line);
		transition: box-shadow 260ms ease;
	}

	.gallery-thumb:hover {
		box-shadow: inset 0 0 0 1px var(--line-strong);
	}

	.gallery-thumb[aria-pressed="true"] {
		box-shadow: inset 0 0 0 2px var(--accent);
	}

	.gallery-thumb :global(img) {
		aspect-ratio: 1;
		width: 100%;
		object-fit: cover;
		display: block;
	}

	.gallery-panel.is-hidden {
		display: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.gallery-panel:not(.is-hidden) {
			animation: sth-panel-in 600ms var(--ease-out-expo) both;
		}

		@keyframes sth-panel-in {
			from {
				opacity: 0;
				transform: scale(1.015);
			}
		}
	}
</style>

<script is:inline>
	(() => {
		const galleries = document.querySelectorAll("[data-tour-gallery]");
		galleries.forEach((gallery) => {
			const panels = Array.from(
				gallery.querySelectorAll("[data-gallery-panel]"),
			);
			const thumbs = Array.from(
				gallery.querySelectorAll("[data-gallery-thumb]"),
			);

			thumbs.forEach((thumb) => {
				if (!(thumb instanceof HTMLElement)) return;
				if (thumb.dataset.galleryBound === "1") return;
				thumb.dataset.galleryBound = "1";

				thumb.addEventListener("click", () => {
					const active = thumb.dataset.galleryThumb;
					panels.forEach((panel) =>
						panel.classList.toggle(
							"is-hidden",
							panel.dataset.galleryPanel !== active,
						),
					);
					thumbs.forEach((button) => {
						button.setAttribute(
							"aria-pressed",
							String(button === thumb),
						);
					});
				});
			});
		});
	})();
</script>
