---
import { Image } from "emdash/ui";
import Star from "@lucide/astro/icons/star";
import { resolveLocale, t } from "../i18n/utils";
import type { TourGoogleSocialProof } from "../utils/tour-google-social-proof";

interface Props {
	googleSocialProof: TourGoogleSocialProof;
	locale?: string;
}

const { googleSocialProof, locale: localeProp } = Astro.props;
const { score, reviewCount, profileUrl, reviews } = googleSocialProof;

const locale = resolveLocale(localeProp ?? Astro.currentLocale);
const starSlots = [1, 2, 3, 4, 5] as const;
const hasScore = score > 0 || reviewCount > 0 || Boolean(profileUrl);
const show = hasScore || reviews.length > 0;
---

{
	show && (
		<div class="review-rail">
			<div class="review-rail__row">
				{hasScore && (
					<aside class="review-rail__score">
						{score > 0 && (
							<p
								class="review-rail__score-value"
								aria-label={t(locale, "reviewAvgLabel", {
									score: score.toFixed(1),
								})}
							>
								{score.toFixed(1)}
							</p>
						)}
						{reviewCount > 0 && (
							<p class="review-rail__score-count">
								{t(locale, "reviewCount", { count: reviewCount })}
							</p>
						)}
						{profileUrl && (
							<a
								class="review-rail__score-link"
								href={profileUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								{t(locale, "reviewSeeOnGoogle")}
							</a>
						)}
					</aside>
				)}

				{reviews.length > 0 && (
					<div
						class="review-rail__track"
						role="list"
						aria-label={t(locale, "reviewGoogleList")}
					>
						{reviews.map((item) => {
							const rating = Math.min(5, Math.max(0, Number(item.rating) || 5));
							return (
								<div class="review-rail__item" role="listitem">
									<div class="review-rail__card">
										<div
											class="star-row review-rail__card-stars"
											aria-label={t(locale, "reviewRatingLabel", { rating })}
										>
											{starSlots.map((n) => (
												<Star
													class={`star-row__icon${n <= rating ? " is-filled" : ""}`}
													size={12}
													stroke-width={1.5}
													aria-hidden="true"
												/>
											))}
										</div>
										<blockquote class="review-rail__quote">
											<p>{item.quote}</p>
										</blockquote>
										<div class="review-rail__author">
											{item.avatarSrc ? (
												<span class="review-rail__avatar">
													<img
														src={item.avatarSrc}
														alt=""
														width="24"
														height="24"
														loading="lazy"
														decoding="async"
														referrerpolicy="no-referrer"
													/>
												</span>
											) : (
												item.avatar && (
													<span class="review-rail__avatar">
														<Image image={item.avatar} />
													</span>
												)
											)}
											{item.reviewUrl ? (
												<a
													class="review-rail__name"
													href={item.reviewUrl}
													target="_blank"
													rel="noopener noreferrer"
												>
													{item.author}
												</a>
											) : (
												<span class="review-rail__name">{item.author}</span>
											)}
										</div>
									</div>
								</div>
							);
						})}
					</div>
				)}
			</div>
		</div>
	)
}
