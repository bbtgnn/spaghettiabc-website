---
import { Image } from "emdash/ui";

interface Props {
	href: string;
	title: string;
	excerpt?: string | null;
	destination?: string | null;
	duration?: string | null;
	price?: string | null;
	image?: {
		id: string;
		src?: string;
		alt?: string;
		width?: number;
		height?: number;
	} | null;
	/** Compact thumb + title for the secondary rail */
	compact?: boolean;
	index?: number;
}

const {
	href,
	title,
	excerpt,
	destination,
	duration,
	price,
	image,
	compact = false,
	index = 0,
} = Astro.props;

const meta = [destination, duration].filter(Boolean).join(" · ");
---

<article class:list={["tour-card", compact && "tour-card--compact"]}>
	<a class="tour-card__link" href={href}>
		{
			image && (
				<div class="tour-card__media">
					<Image
						image={image}
						loading={index < 2 ? "eager" : "lazy"}
						priority={index < 2}
					/>
				</div>
			)
		}
		<div class="tour-card__body">
			<h3 class="type-h3 tour-card__title">{title}</h3>
			{
				!compact && excerpt && (
					<p class="type-body tour-card__excerpt">{excerpt}</p>
				)
			}
			{!compact && (price || meta) && (
				<div class="tour-card__footer">
					{price && <p class="mono tour-card__price">{price}</p>}
					{meta && <p class="label tour-card__meta">{meta}</p>}
				</div>
			)}
		</div>
	</a>
</article>
