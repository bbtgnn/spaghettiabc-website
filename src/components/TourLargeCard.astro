---
import { Image } from "emdash/ui";

interface Props {
	href: string;
	title: string;
	excerpt?: string | null;
	destination?: string | null;
	duration?: string | null;
	price?: string | null;
	image?: {
		id: string;
		src?: string;
		alt?: string;
		width?: number;
		height?: number;
	} | null;
	/** Visual treatment for Sezione Tour highlight / compact rail */
	layout?: "stack" | "row" | "compact";
	index?: number;
}

const {
	href,
	title,
	excerpt,
	destination,
	duration,
	price,
	image,
	layout = "stack",
	index = 0,
} = Astro.props;

const meta = [destination, duration].filter(Boolean).join(" · ");
const isCompact = layout === "compact";
---

<article class:list={["tour-card", `tour-card--${layout}`]}>
	<a class="tour-card__link" href={href}>
		{
			image && (
				<div class="tour-card__media">
					<Image
						image={image}
						loading={index < 2 ? "eager" : "lazy"}
						priority={index < 2}
					/>
				</div>
			)
		}
		<div class="tour-card__body">
			<h3 class="type-h3 tour-card__title">{title}</h3>
			{
				!isCompact && excerpt && (
					<p class="type-body tour-card__excerpt">{excerpt}</p>
				)
			}
			{!isCompact && (price || meta) && (
				<div class="tour-card__footer">
					{price && <p class="mono tour-card__price">{price}</p>}
					{meta && <p class="label tour-card__meta">{meta}</p>}
				</div>
			)}
		</div>
	</a>
</article>
