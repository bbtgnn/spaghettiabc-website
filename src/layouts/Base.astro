---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import FontPairingPicker from "../components/FontPairingPicker.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

const isDev = import.meta.env.DEV;
if (isDev) {
	await import("../styles/font-pairings-preview.css");
}

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Kept for call-site compatibility; header is always sticky in Atelier mode */
	overlayHeader?: boolean;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;
const currentPath = Astro.url.pathname;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="it" data-font-ui-case="sans">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#f4f4f2" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>
			(() => {
				try {
					const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
					if (!reduce) document.documentElement.setAttribute("data-motion", "on");
				} catch {
					/* no-op */
				}
			})();
		</script>
		{
			isDev && (
				<script is:inline>
					(() => {
						const KEYS = {
							display: "spaghettiabc-font-display",
							body: "spaghettiabc-font-body",
							ui: "spaghettiabc-font-ui",
						};
						const DEFAULTS = {
							display: "fraunces",
							body: "source-serif-4",
							ui: "fira-sans",
						};
						const VALID = {
							display: ["newsreader", "fraunces", "lora", "cormorant"],
							body: ["source-serif-4", "literata"],
							ui: ["body", "tsukimi", "fira-sans"],
						};
						const pick = (key, valid, fallback) => {
							try {
								const stored = localStorage.getItem(key);
								return stored && valid.includes(stored) ? stored : fallback;
							} catch {
								return fallback;
							}
						};
						const root = document.documentElement;
						const ui = pick(KEYS.ui, VALID.ui, DEFAULTS.ui);
						root.setAttribute(
							"data-font-display",
							pick(KEYS.display, VALID.display, DEFAULTS.display),
						);
						root.setAttribute(
							"data-font-body",
							pick(KEYS.body, VALID.body, DEFAULTS.body),
						);
						root.setAttribute("data-font-ui", ui);
						/* UI=body is always serif; tsukimi / fira-sans are sans */
						root.setAttribute(
							"data-font-ui-case",
							ui === "body" ? "serif" : "sans",
						);
					})();
				</script>
			)
		}
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<a class="sr-only" href="#main-content">Vai al contenuto</a>

		<SiteHeader
			siteTitle={siteTitle}
			siteLogo={siteLogo}
			items={menu?.items}
			currentPath={currentPath}
		/>

		<main class="site-main" id="main-content">
			<slot />
		</main>

		<EmDashBodyEnd page={pageCtx} />

		{isDev && <FontPairingPicker />}

		<script is:inline>
			(() => {
				if (document.documentElement.getAttribute("data-motion") !== "on") return;
				const nodes = document.querySelectorAll("[data-reveal]");
				if (!nodes.length || !("IntersectionObserver" in window)) {
					nodes.forEach((el) => el.classList.add("is-in"));
					return;
				}
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add("is-in");
							io.unobserve(entry.target);
						}
					},
					{ rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
				);
				nodes.forEach((el) => io.observe(el));
			})();

			/* Horizontal rails (overflow-x) otherwise trap trackpad vertical scroll. */
			(() => {
				const tracks = document.querySelectorAll(".tour-rail__track");
				for (const track of tracks) {
					track.addEventListener(
						"wheel",
						(event) => {
							if (event.shiftKey) return;
							if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
							if (event.deltaY === 0) return;
							event.preventDefault();
							window.scrollBy({ top: event.deltaY, left: 0, behavior: "instant" });
						},
						{ passive: false },
					);
				}
			})();
		</script>
	</body>
</html>
