---
import Base from "../../layouts/Base.astro";
import { gateDevOnly } from "../../utils/dev-only";
import { IL_MIO_MONDO_VARIANTS } from "./variants";
import "../../styles/_dev/il-mio-mondo-playground.css";

const denied = await gateDevOnly(Astro);
if (denied) return denied;
---

<Base
	title="Playground Sezione Il mio mondo"
	description="Scegli una variante di layout per la Sezione Il mio mondo (solo DEV)."
	hideHeader
>
	<div class="pg">
		<header class="pg__intro">
			<p class="mono pg__kicker">/_dev · playground</p>
			<h1 class="type-h2 pg__title">Sezione Il mio mondo</h1>
			<p class="type-body pg__lede">
				Tre bozze separate — una pagina per variante. Apri quella da mostrare al
				capo; in ciascuna trovi desktop e mobile. Solo la sezione, senza header
				del sito. Instagram e Substack sono fixture; la Ricetta selezionata
				arriva dal CMS.
			</p>
		</header>

		<nav class="pg__hub" aria-label="Varianti Sezione Il mio mondo">
			<ul class="pg-hub__list">
				{
					IL_MIO_MONDO_VARIANTS.map((variant) => (
						<li>
							<a class="pg-hub__card" href={variant.href}>
								<span class="mono pg-hub__id">{variant.id.toUpperCase()}</span>
								<span class="pg-hub__title">{variant.title}</span>
								<span class="pg-hub__desc">{variant.desc}</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</Base>
