---
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import SezioneTourMock from "../components/_dev/SezioneTourMock.astro";
import { gateDevOnly } from "../utils/dev-only";
import "../styles/_dev/sezione-tour-playground.css";

const denied = await gateDevOnly(Astro);
if (denied) return denied;

const { entry: home, cacheHint } = await getEmDashEntry("homepage", "home", {
	references: { featured_tours: true },
});
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
}

const featuredTours = home?.references?.featured_tours?.entries ?? [];
const largeTours = featuredTours.slice(0, 2);
const railTours = featuredTours.slice(2);
const googleReviews = (home?.data.google_reviews ?? []) as Array<{
	author: string;
	quote: string;
	rating?: number | null;
	avatar?: {
		id: string;
		src?: string;
		alt?: string;
		width?: number;
		height?: number;
	} | null;
	review_url?: string | null;
}>;

const variants = [
	{
		id: "a" as const,
		title: "Variante A — Due grandi + rail",
		desc: "Coppia 50/50 (stack su mobile), rail dei teaser, poi recensioni compatte.",
	},
	{
		id: "b" as const,
		title: "Variante B — Schede orizzontali",
		desc: "Due card immagine/testo affiancati, recensioni integrate, poi il rail.",
	},
	{
		id: "c" as const,
		title: "Variante C — Asimmetrica",
		desc: "Primo tour dominante, secondo secondario, rail e recensioni in coda.",
	},
];

const viewports = [
	{ id: "desktop" as const, label: "Desktop · 1280" },
	{ id: "mobile" as const, label: "Mobile · 390" },
];
---

<Base
	title="Playground Sezione Tour"
	description="Confronta tre layout per la Sezione Tour (solo DEV)."
	hideHeader
>
	<div class="pg">
		<header class="pg__intro">
			<p class="mono pg__kicker">/_dev · playground</p>
			<h1 class="type-h2 pg__title">Sezione Tour</h1>
			<p class="type-body pg__lede">
				Tre bozze affiancate (desktop e mobile). I frame mostrano solo la sezione —
				senza header del sito. Dati live dalla homepage CMS.
			</p>
		</header>

		{
			!home ? (
				<section class="pg__variant">
					<p class="type-body">
						Homepage non configurata.{" "}
						<a class="link" href="/_emdash/admin/content/homepage">Apri l’admin</a>.
					</p>
				</section>
			) : (
				variants.map((variant) => (
					<section class="pg__variant" aria-labelledby={`variant-${variant.id}`}>
						<div class="pg__variant-head">
							<h2 class="pg__variant-title" id={`variant-${variant.id}`}>
								{variant.title}
							</h2>
							<p class="pg__variant-desc">{variant.desc}</p>
						</div>

						<div class="pg__frames">
							{viewports.map((viewport) => (
								<figure class="pg-frame" data-viewport={viewport.id}>
									<figcaption class="mono pg-frame__label">{viewport.label}</figcaption>
									<div class="pg-frame__viewport">
										<SezioneTourMock
											variant={variant.id}
											viewport={viewport.id}
											tourTitle={home.data.tour_title}
											tourSubtitle={home.data.tour_subtitle}
											tourCtaLabel={home.data.tour_cta_label}
											largeTours={largeTours}
											railTours={railTours}
											reviews={googleReviews}
										/>
									</div>
								</figure>
							))}
						</div>
					</section>
				))
			)
		}
	</div>
</Base>

<script>
	/* Vertical-scroll passthrough into the frame viewport (captures before Base’s window scroll). */
	(() => {
		const tracks = document.querySelectorAll(
			".pg-review-rail__track, .pg-frame__viewport .tour-rail__track",
		);
		for (const track of tracks) {
			track.addEventListener(
				"wheel",
				(event) => {
					const e = event as WheelEvent;
					if (e.shiftKey) return;
					if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
					if (e.deltaY === 0) return;
					const viewport = track.closest(".pg-frame__viewport");
					if (!(viewport instanceof HTMLElement)) return;
					e.preventDefault();
					e.stopImmediatePropagation();
					viewport.scrollBy({ top: e.deltaY, left: 0, behavior: "instant" });
				},
				{ passive: false, capture: true },
			);
		}
	})();
</script>
