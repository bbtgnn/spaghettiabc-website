---
/**
 * Scheda Edizione — full fields for one published libro entry.
 */
import {
	decodeSlug,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: book, cacheHint } = await getEmDashEntry("libri", slug);

if (!book) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const path = Astro.url.pathname.replace(/\/$/, "");
const seo = getSeoMeta(book, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path,
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "libri", id: book.data.id, slug: book.id }}
>
	<article class="book-page">
		<p class="book-page__back">
			<a class="text-link" href="/#libro">← Il libro</a>
		</p>

		<header class="book-page__header">
			{
				book.data.cover && (
					<div class="book-page__cover" {...book.edit.cover}>
						<Image image={book.data.cover} />
					</div>
				)
			}
			<div class="book-page__intro">
				<h1 class="book-page__title" {...book.edit.title}>
					{book.data.title}
				</h1>
				{
					book.data.subtitle && (
						<p class="book-page__subtitle" {...book.edit.subtitle}>
							{book.data.subtitle}
						</p>
					)
				}
				{
					book.data.buy_url && (
						<p class="book-page__buy">
							<a
								class="btn btn-primary"
								href={book.data.buy_url}
								{...book.edit.buy_url}
							>
								<span {...book.edit.buy_label}>
									{book.data.buy_label?.trim() || "Acquista"}
								</span>
							</a>
						</p>
					)
				}
			</div>
		</header>

		{
			book.data.content && (
				<div class="book-page__content" {...book.edit.content}>
					<PortableText value={book.data.content} />
				</div>
			)
		}
	</article>
</Base>

<style>
	.book-page {
		width: min(100% - 2rem, var(--content, var(--shell, 1280px)));
		margin: 0 auto;
		padding: var(--space-7, 2.5rem) 0;
		display: grid;
		gap: var(--space-6, 2rem);
	}

	.book-page__back {
		margin: 0;
	}

	.book-page__header {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: var(--space-5, 1.5rem);
		align-items: center;
	}

	.book-page__cover {
		overflow: hidden;
		max-width: 22rem;
	}

	.book-page__cover :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.book-page__intro {
		display: grid;
		gap: var(--space-3, 0.85rem);
		max-width: 34rem;
	}

	.book-page__title {
		font-size: var(--text-3xl, var(--font-display-size, 2.5rem));
		text-wrap: balance;
	}

	.book-page__subtitle {
		font-size: var(--text-xl, 1.25rem);
		color: var(--muted, var(--color-sea));
	}

	.book-page__buy {
		margin: 0.35rem 0 0;
	}

	.book-page__content {
		max-width: var(--measure, 65ch);
		font-size: var(--text-lg, 1.125rem);
		color: var(--muted, var(--color-ink-soft));
	}

	.book-page__content :global(p) {
		margin-bottom: 1.1em;
	}

	@media (max-width: 800px) {
		.book-page__header {
			grid-template-columns: 1fr;
		}

		.book-page__cover {
			max-width: 16rem;
		}
	}
</style>
