---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entry: collaborations, cacheHint } = await getEmDashEntry(
	"collaborations",
	"collaborazioni",
);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const logos = collaborations?.data.logos ?? [];
const testimonials = collaborations?.data.testimonials ?? [];
const gallery = collaborations?.data.gallery ?? [];

const seo = collaborations
	? getSeoMeta(collaborations, {
			siteTitle,
			siteUrl: Astro.url.origin,
			path: "/collaborazioni",
		})
	: {
			title: `Collaborazioni · ${siteTitle}`,
			ogTitle: "Collaborazioni",
			description: "Collaborazioni — contenuto non ancora disponibile.",
			canonical: undefined,
			ogImage: undefined,
		};
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={collaborations
		? {
				collection: "collaborations",
				id: collaborations.data.id,
				slug: collaborations.id,
			}
		: undefined}
>
	{
		collaborations ? (
			<article class="collaborations-page">
				<header class="collaborations-page__header">
					<div class="collaborations-page__intro">
						<h1 class="collaborations-page__title" {...collaborations.edit.title}>
							{collaborations.data.title}
						</h1>
						{collaborations.data.subtitle && (
							<p class="collaborations-page__subtitle" {...collaborations.edit.subtitle}>
								{collaborations.data.subtitle}
							</p>
						)}
						{collaborations.data.excerpt && (
							<p class="collaborations-page__excerpt" {...collaborations.edit.excerpt}>
								{collaborations.data.excerpt}
							</p>
						)}
					</div>
				</header>

				{collaborations.data.content && (
					<div class="collaborations-page__content" {...collaborations.edit.content}>
						<PortableText value={collaborations.data.content} />
					</div>
				)}

				{logos.length > 0 && (
					<section class="collaborations-page__block" aria-labelledby="collaborazioni-loghi">
						<h2 id="collaborazioni-loghi" class="collaborations-page__heading">
							Partner
						</h2>
						<ul class="collaborations-page__logos" {...collaborations.edit.logos}>
							{logos.map((item) => (
								<li class="collaborations-page__logo">
									{item.logo && <Image image={item.logo} />}
									{item.name && (
										<span class="collaborations-page__logo-name">{item.name}</span>
									)}
								</li>
							))}
						</ul>
					</section>
				)}

				{testimonials.length > 0 && (
					<section
						class="collaborations-page__block"
						aria-labelledby="collaborazioni-testimonianze"
					>
						<h2 id="collaborazioni-testimonianze" class="collaborations-page__heading">
							Testimonianze
						</h2>
						<ul
							class="collaborations-page__testimonials"
							{...collaborations.edit.testimonials}
						>
							{testimonials.map((item) => {
								const rating = Number(item.rating) || 5;
								return (
									<li class="testimonial-card">
										<div
											class="testimonial-card__rating"
											role="img"
											aria-label={`Valutazione: ${rating} su 5`}
										>
											{Array.from({ length: 5 }, (_, i) => (
												<span
													class:list={[
														"testimonial-card__star",
														i < rating && "testimonial-card__star--filled",
													]}
													aria-hidden="true"
												>
													★
												</span>
											))}
										</div>
										<blockquote class="testimonial-card__quote">
											<p>{item.quote}</p>
										</blockquote>
										<p class="testimonial-card__author">
											<span class="testimonial-card__name">{item.author}</span>
											{item.role_or_company && (
												<span class="testimonial-card__role">{item.role_or_company}</span>
											)}
										</p>
									</li>
								);
							})}
						</ul>
					</section>
				)}

				{gallery.length > 0 && (
					<section class="collaborations-page__block" aria-labelledby="collaborazioni-gallery">
						<h2 id="collaborazioni-gallery" class="collaborations-page__heading">
							Progetti
						</h2>
						<ul class="collaborations-page__gallery" {...collaborations.edit.gallery}>
							{gallery.map((item) => (
								<li class="collaborations-page__gallery-item">
									{item.image && <Image image={item.image} />}
								</li>
							))}
						</ul>
					</section>
				)}
			</article>
		) : (
			<section class="collaborations-page collaborations-page--empty">
				<h1>Collaborazioni</h1>
				<p>
					Le Collaborazioni non sono ancora disponibili.{" "}
					<a href="/_emdash/admin/content/collaborations">Apri l’admin</a>.
				</p>
			</section>
		)
	}
</Base>

<style>
	.collaborations-page {
		width: min(100% - 2rem, var(--content));
		margin: 0 auto;
		padding: var(--space-7) 0;
		display: grid;
		gap: var(--space-6);
	}

	.collaborations-page__header {
		animation: rise-in 800ms var(--ease-out) both;
	}

	.collaborations-page__intro {
		display: grid;
		gap: var(--space-3);
		max-width: 34rem;
	}

	.collaborations-page__title {
		font-size: var(--text-3xl);
		text-wrap: balance;
	}

	.collaborations-page__subtitle {
		font-size: var(--text-xl);
		color: var(--color-sea);
	}

	.collaborations-page__excerpt {
		font-size: var(--text-lg);
		color: var(--color-ink-soft);
	}

	.collaborations-page__content {
		max-width: var(--measure);
		font-size: var(--text-lg);
		color: var(--color-ink-soft);
		animation: rise-in 700ms var(--ease-out) 80ms both;
	}

	.collaborations-page__content :global(p) {
		margin-bottom: 1.1em;
	}

	.collaborations-page__block {
		display: grid;
		gap: var(--space-4);
		animation: rise-in 700ms var(--ease-out) 100ms both;
	}

	.collaborations-page__heading {
		font-size: var(--text-xl);
		margin: 0;
	}

	.collaborations-page__logos {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-4);
	}

	.collaborations-page__logo {
		display: grid;
		gap: var(--space-2);
		place-items: center;
		padding: var(--space-3);
		background: color-mix(in srgb, var(--color-foam) 70%, #fff);
		border-radius: var(--radius);
		text-align: center;
	}

	.collaborations-page__logo :global(img) {
		max-height: 3.5rem;
		width: auto;
		max-width: 100%;
		object-fit: contain;
	}

	.collaborations-page__logo-name {
		font-size: var(--text-xs);
		color: var(--color-ink-soft);
	}

	.collaborations-page__testimonials {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-4);
	}

	.testimonial-card {
		display: grid;
		gap: var(--space-3);
		padding: var(--space-4);
		background: color-mix(in srgb, var(--color-foam) 55%, #fff);
		border-radius: var(--radius);
		border: 1px solid var(--color-line);
	}

	.testimonial-card__rating {
		display: flex;
		gap: 0.15rem;
		color: var(--color-sun);
		font-size: var(--text-sm);
		letter-spacing: 0.04em;
	}

	.testimonial-card__star {
		opacity: 0.28;
	}

	.testimonial-card__star--filled {
		opacity: 1;
	}

	.testimonial-card__quote {
		margin: 0;
	}

	.testimonial-card__quote p {
		margin: 0;
		color: var(--color-ink-soft);
		text-wrap: pretty;
	}

	.testimonial-card__author {
		margin: 0;
		display: grid;
		gap: 0.15rem;
	}

	.testimonial-card__name {
		font-weight: 650;
	}

	.testimonial-card__role {
		font-size: var(--text-sm);
		color: var(--color-sea);
	}

	.collaborations-page__gallery {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-3);
	}

	.collaborations-page__gallery-item {
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-foam);
	}

	.collaborations-page__gallery-item :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 4 / 3;
	}

	.collaborations-page--empty {
		color: var(--color-ink-soft);
	}

	.collaborations-page--empty a {
		font-weight: 650;
		color: var(--color-sea-deep);
	}

	@media (max-width: 800px) {
		.collaborations-page__logos {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.collaborations-page__testimonials,
		.collaborations-page__gallery {
			grid-template-columns: 1fr;
		}
	}
</style>
