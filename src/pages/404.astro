---
import Base from "../layouts/base.astro";
import { localePath, resolveLocale, t } from "../i18n/utils";

const locale = resolveLocale(Astro.currentLocale);
---

<Base title={t(locale, "notFoundTitle")}>
	<h1>{t(locale, "notFoundHeading")}</h1>
	<p>{t(locale, "notFoundBody")}</p>
	<a href={localePath(locale, "/")}>{t(locale, "notFoundHome")}</a>
</Base>
