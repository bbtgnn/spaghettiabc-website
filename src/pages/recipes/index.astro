---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: recipes,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("recipes", {
	orderBy: { published_at: "desc" },
	limit: 40,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const categoriesByEntry = await getTermsForEntries(
	"recipes",
	recipes.map((r) => r.data.id),
	"recipe_category",
);
const recipesWithCategories = recipes.map((recipe) => ({
	recipe,
	categories: categoriesByEntry.get(recipe.data.id) ?? [],
}));

const pageTitle = "Catalogo ricette";
const pageDescription =
	"Ricette di Flavia — pasta, baking, and seasonal dishes from Puglia and beyond.";
---

<Base title={pageTitle} description={pageDescription} paletteSlot="page-recipes">
	<section class="shell recipes-catalog">
		<header class="recipes-catalog__intro">
			<h1 class="type-hero">{pageTitle}</h1>
			<p class="type-lead recipes-catalog__lede">{pageDescription}</p>
		</header>

		{
			recipesWithCategories.length === 0 ? (
				<p class="type-body recipes-catalog__empty">
					Nessuna ricetta ancora.{" "}
					<a class="link" href="/_emdash/admin/content/recipes/new">Creane una</a>.
				</p>
			) : (
				<ul class="recipes-catalog__list">
					{recipesWithCategories.map(({ recipe, categories }) => (
						<li class="recipes-catalog__item">
							<a class="recipes-catalog__link" href={`/recipes/${recipe.id}`}>
								{recipe.data.featured_image && (
									<div class="recipes-catalog__media" {...recipe.edit.featured_image}>
										<Image image={recipe.data.featured_image} />
									</div>
								)}
								<h2 class="type-h3" {...recipe.edit.title}>
									{recipe.data.title}
								</h2>
							</a>
							{categories.length > 0 && (
								<p class="label recipes-catalog__cats">
									{categories.map((c) => c.label).join(" · ")}
								</p>
							)}
						</li>
					))}
				</ul>
			)
		}

		{
			(cursor || nextCursor) && (
				<nav class="recipes-catalog__pager" aria-label="Paginazione">
					{cursor && <a class="text-link" href="/recipes">Prima pagina</a>}
					{nextCursor && (
						<a
							class="text-link"
							href={`/recipes?cursor=${encodeURIComponent(nextCursor)}`}
						>
							Pagina successiva
						</a>
					)}
				</nav>
			)
		}
	</section>
</Base>

<style>
	.recipes-catalog {
		padding-block: 2.5rem 4rem;
	}

	.recipes-catalog__intro {
		display: grid;
		gap: 1.25rem;
	}

	.recipes-catalog__empty {
		margin-top: 3rem;
	}

	.recipes-catalog__list {
		list-style: none;
		margin: 3rem 0 0;
		padding: 0;
		display: grid;
		gap: 2.5rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
	}

	.recipes-catalog__item {
		display: grid;
		gap: 0.75rem;
		align-content: start;
	}

	.recipes-catalog__link {
		display: grid;
		gap: 0.75rem;
		text-decoration: none;
		color: inherit;
	}

	.recipes-catalog__media :global(img) {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	.recipes-catalog__cats {
		margin: 0;
	}

	.recipes-catalog__pager {
		margin-top: 3rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
	}
</style>
