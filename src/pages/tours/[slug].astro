---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: tour, cacheHint } = await getEmDashEntry("tours", slug);

if (!tour) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(tour, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const gallery = tour.data.gallery ?? [];
const meta = [tour.data.destination, tour.data.duration, tour.data.price]
	.filter(Boolean)
	.join(" · ");
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	overlayHeader={Boolean(tour.data.featured_image)}
	content={{ collection: "tours", id: tour.data.id, slug }}
>
	<article class="tour">
		<header class="tour-hero">
			{
				tour.data.featured_image && (
					<div class="tour-hero__media" {...tour.edit.featured_image}>
						<Image image={tour.data.featured_image} />
					</div>
				)
			}
			<div class="tour-hero__veil" aria-hidden="true" />
			<div class="tour-hero__content">
				{meta && <p class="tour-hero__meta">{meta}</p>}
				<h1 class="tour-hero__title" {...tour.edit.title}>{tour.data.title}</h1>
				{
					tour.data.excerpt && (
						<p class="tour-hero__excerpt" {...tour.edit.excerpt}>
							{tour.data.excerpt}
						</p>
					)
				}
			</div>
		</header>

		<div class="tour-body">
			<div class="tour-body__prose">
				<PortableText value={tour.data.content} />
			</div>

			{
				gallery.length > 0 && (
					<section class="tour-gallery">
						<h2 class="tour-gallery__title">Gallery</h2>
						<ul class="tour-gallery__list">
							{gallery.map((row) =>
								row.image ? (
									<li class="tour-gallery__item">
										<Image image={row.image} />
									</li>
								) : null,
							)}
						</ul>
					</section>
				)
			}

			<p class="tour-back">
				<a href="/tours">← Tutti i tour</a>
			</p>
		</div>
	</article>
</Base>

<style>
	.tour-hero {
		position: relative;
		isolation: isolate;
		min-height: min(78svh, 44rem);
		display: grid;
		align-items: end;
		color: #fff;
		overflow: hidden;
		background: var(--color-ink);
	}

	.tour-hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.tour-hero__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		animation: media-drift 4.5s var(--ease-out) both;
	}

	.tour-hero__veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			180deg,
			rgb(20 35 58 / 0.2) 0%,
			rgb(20 35 58 / 0.55) 100%
		);
		animation: fade-in 800ms var(--ease-out) both;
	}

	.tour-hero__content {
		position: relative;
		z-index: 2;
		width: min(100% - 2rem, var(--content));
		margin: 0 auto;
		padding: calc(var(--space-7) + 1rem) 0 var(--space-5);
		display: grid;
		gap: var(--space-3);
		max-width: 42rem;
		animation: rise-in 850ms var(--ease-out) both;
	}

	.tour-hero__meta {
		font-size: var(--text-xs);
		font-weight: 650;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-sun);
	}

	.tour-hero__title {
		font-size: var(--text-3xl);
		text-wrap: balance;
	}

	.tour-hero__excerpt {
		max-width: 34rem;
		font-size: var(--text-lg);
		color: rgb(255 255 255 / 0.9);
	}

	.tour-body {
		width: min(100% - 2rem, var(--content));
		margin: 0 auto;
		padding: var(--space-6) 0 var(--space-7);
		display: grid;
		gap: var(--space-6);
	}

	.tour-body__prose {
		max-width: var(--measure);
		font-size: var(--text-lg);
		color: var(--color-ink-soft);
		animation: rise-in 700ms var(--ease-out) 80ms both;
	}

	.tour-body__prose :global(p) {
		margin-bottom: 1.1em;
	}

	.tour-body__prose :global(h2),
	.tour-body__prose :global(h3) {
		color: var(--color-ink);
		margin: 1.6em 0 0.5em;
	}

	.tour-gallery__title {
		font-size: var(--text-xl);
		margin-bottom: var(--space-4);
	}

	.tour-gallery__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: var(--space-3);
	}

	.tour-gallery__item {
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-foam);
	}

	.tour-gallery__item :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 4 / 3;
	}

	.tour-back a {
		font-weight: 650;
		color: var(--color-sea-deep);
		text-decoration: none;
	}

	.tour-back a:hover {
		text-decoration: underline;
		text-underline-offset: 0.28em;
	}

	@media (max-width: 720px) {
		.tour-hero {
			min-height: 70svh;
		}

		.tour-hero__content {
			padding-top: calc(var(--space-7) + 3rem);
		}
	}
</style>
