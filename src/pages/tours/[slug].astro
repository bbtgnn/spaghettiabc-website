---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: tour, cacheHint } = await getEmDashEntry("tours", slug);

if (!tour) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(tour, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

type TourImage = NonNullable<typeof tour.data.featured_image>;

const galleryImages: TourImage[] = [
	...(tour.data.featured_image ? [tour.data.featured_image] : []),
	...(tour.data.gallery ?? [])
		.map((row) => row.image)
		.filter((image): image is TourImage => Boolean(image)),
];

const specs: {
	term: string;
	value: string;
	edit?: Record<string, unknown>;
}[] = [];
if (tour.data.duration) {
	specs.push({
		term: "Durata",
		value: tour.data.duration,
		edit: tour.edit.duration,
	});
}
if (tour.data.group_size) {
	specs.push({
		term: "Gruppo",
		value: tour.data.group_size,
		edit: tour.edit.group_size,
	});
}
if (tour.data.language) {
	specs.push({
		term: "Lingua",
		value: tour.data.language,
		edit: tour.edit.language,
	});
}
if (tour.data.included) {
	specs.push({
		term: "Incluso",
		value: tour.data.included,
		edit: tour.edit.included,
	});
}

const faqItems = (tour.data.faq ?? []).filter(
	(row): row is { question: string; answer: string } =>
		Boolean(row?.question && row?.answer),
);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "tours", id: tour.data.id, slug }}
>
	<article class="shell scheda-tour">
		<nav class="mono scheda-tour__crumb" aria-label="Breadcrumb">
			<a href="/tours" class="link">Catalogo tour</a>
			<span aria-hidden="true">/</span>
			<span class="scheda-tour__crumb-current" aria-current="page"
				>{tour.data.title}</span
			>
		</nav>

		<div class="scheda-tour__split">
			{
				galleryImages.length > 0 && (
					<section
						class="scheda-tour__gallery"
						aria-label={`${tour.data.title} images`}
						data-tour-gallery
					>
						<div class="scheda-tour__stage" {...tour.edit.featured_image}>
							{galleryImages.map((image, index) => (
								<div
									class:list={[
										"gallery-panel",
										index !== 0 && "is-hidden",
									]}
									data-gallery-panel={index}
								>
									<Image image={image} />
								</div>
							))}
						</div>

						{galleryImages.length >= 2 && (
							<div
								class="scheda-tour__thumbs"
								role="group"
								aria-label="Choose an image"
							>
								{galleryImages.map((image, index) => (
									<button
										type="button"
										class="gallery-thumb"
										data-gallery-thumb={index}
										aria-label={`Show view ${index + 1}`}
										aria-pressed={index === 0 ? "true" : "false"}
									>
										<Image image={image} />
									</button>
								))}
							</div>
						)}
					</section>
				)
			}

			<div class="scheda-tour__info">
				{
					tour.data.destination && (
						<p class="label" {...tour.edit.destination}>
							{tour.data.destination}
						</p>
					)
				}
				<h1 class="type-h2 scheda-tour__title" {...tour.edit.title}>
					{tour.data.title}
				</h1>
				{
					tour.data.price && (
						<p class="mono scheda-tour__price" {...tour.edit.price}>
							{tour.data.price}
						</p>
					)
				}

				{
					tour.data.excerpt && (
						<p class="type-body scheda-tour__excerpt" {...tour.edit.excerpt}>
							{tour.data.excerpt}
						</p>
					)
				}

				{
					specs.length > 0 && (
						<dl class="mono scheda-tour__specs">
							{specs.map(({ term, value, edit }) => (
								<div class="scheda-tour__spec" {...edit}>
									<dt>{term}</dt>
									<dd>{value}</dd>
								</div>
							))}
						</dl>
					)
				}

				<button type="button" class="btn btn-primary scheda-tour__cart">
					Add to cart
				</button>
			</div>
		</div>

		{
			tour.data.content && (
				<div class="scheda-tour__content" {...tour.edit.content}>
					<PortableText value={tour.data.content} />
				</div>
			)
		}

		{
			faqItems.length > 0 && (
				<section class="scheda-tour__faq" aria-labelledby="tour-faq-heading" {...tour.edit.faq}>
					<h2 id="tour-faq-heading" class="type-h3 scheda-tour__faq-title">
						Domande frequenti
					</h2>
					<div class="scheda-tour__faq-list">
						{faqItems.map((item) => (
							<details class="scheda-tour__faq-item">
								<summary>{item.question}</summary>
								<p class="type-body">{item.answer}</p>
							</details>
						))}
					</div>
				</section>
			)
		}
	</article>
</Base>

<style>
	.scheda-tour {
		padding-block: 0 4rem;
	}

	.scheda-tour__crumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-block: 1.5rem;
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--muted);
	}

	.scheda-tour__crumb-current {
		color: var(--ink);
	}

	.scheda-tour__split {
		display: grid;
		align-items: start;
		gap: 2.5rem;
		border-top: 1px solid var(--line);
		padding-top: 2rem;
	}

	@media (min-width: 1024px) {
		.scheda-tour__split {
			grid-template-columns: 7fr 5fr;
			gap: 3rem;
		}
	}

	.scheda-tour__stage {
		position: relative;
		overflow: hidden;
		background: var(--surface);
	}

	.scheda-tour__stage :global(img) {
		aspect-ratio: 4 / 5;
		width: 100%;
		object-fit: cover;
		display: block;
	}

	.scheda-tour__thumbs {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.gallery-thumb {
		overflow: hidden;
		padding: 0;
		border: 0;
		background: var(--surface);
		cursor: pointer;
		box-shadow: inset 0 0 0 1px var(--line);
		transition: box-shadow 260ms ease;
	}

	.gallery-thumb:hover {
		box-shadow: inset 0 0 0 1px var(--line-strong);
	}

	.gallery-thumb[aria-pressed="true"] {
		box-shadow: inset 0 0 0 2px var(--accent);
	}

	.gallery-thumb :global(img) {
		aspect-ratio: 1;
		width: 100%;
		object-fit: cover;
		display: block;
	}

	.gallery-panel.is-hidden {
		display: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.gallery-panel:not(.is-hidden) {
			animation: panel-in 600ms var(--ease-out-expo) both;
		}

		@keyframes panel-in {
			from {
				opacity: 0;
				transform: scale(1.015);
			}
		}
	}

	.scheda-tour__info {
		display: grid;
		justify-items: start;
		align-content: start;
	}

	@media (min-width: 1024px) {
		.scheda-tour__info {
			position: sticky;
			top: 7rem;
		}
	}

	.scheda-tour__title {
		margin-top: 1.25rem;
	}

	.scheda-tour__price {
		margin-top: 1.25rem;
		font-size: 1.25rem;
		color: var(--ink);
	}

	.scheda-tour__excerpt {
		margin-top: 2rem;
		max-width: 46ch;
	}

	.scheda-tour__specs {
		width: 100%;
		margin-top: 2.5rem;
		border-top: 1px solid var(--line);
		font-size: 0.8125rem;
	}

	.scheda-tour__spec {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		border-bottom: 1px solid var(--line);
		padding-block: 0.75rem;
	}

	.scheda-tour__spec dt {
		color: var(--muted);
	}

	.scheda-tour__spec dd {
		margin: 0;
		text-align: right;
		color: var(--ink);
	}

	.scheda-tour__cart {
		margin-top: 2.5rem;
		width: 100%;
	}

	.scheda-tour__content {
		margin-top: 4rem;
		max-width: var(--measure);
		color: var(--muted);
	}

	.scheda-tour__content :global(p) {
		margin-bottom: 1.1em;
	}

	.scheda-tour__content :global(h2),
	.scheda-tour__content :global(h3) {
		color: var(--title);
		margin: 1.6em 0 0.5em;
	}

	.scheda-tour__faq {
		margin-top: 4rem;
		max-width: var(--measure);
		border-top: 1px solid var(--line);
		padding-top: 2.5rem;
	}

	.scheda-tour__faq-title {
		margin: 0 0 1.25rem;
		color: var(--title);
	}

	.scheda-tour__faq-list {
		display: grid;
		gap: 0;
	}

	.scheda-tour__faq-item {
		border-bottom: 1px solid var(--line);
	}

	.scheda-tour__faq-item summary {
		cursor: pointer;
		list-style: none;
		padding-block: 1rem;
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		color: var(--ink);
	}

	.scheda-tour__faq-item summary::-webkit-details-marker {
		display: none;
	}

	.scheda-tour__faq-item summary::before {
		content: "▼ ";
		color: var(--muted);
		font-size: 0.65em;
	}

	.scheda-tour__faq-item[open] summary::before {
		content: "▲ ";
	}

	.scheda-tour__faq-item p {
		margin: 0 0 1.25rem;
		max-width: 46ch;
		color: var(--muted);
	}
</style>

<script is:inline>
	(() => {
		const gallery = document.querySelector("[data-tour-gallery]");
		if (!gallery) return;

		const panels = Array.from(gallery.querySelectorAll("[data-gallery-panel]"));
		const thumbs = Array.from(gallery.querySelectorAll("[data-gallery-thumb]"));

		thumbs.forEach((thumb) => {
			thumb.addEventListener("click", () => {
				const active = thumb.dataset.galleryThumb;
				panels.forEach((panel) =>
					panel.classList.toggle(
						"is-hidden",
						panel.dataset.galleryPanel !== active,
					),
				);
				thumbs.forEach((button) => {
					button.setAttribute("aria-pressed", String(button === thumb));
				});
			});
		});
	})();
</script>
