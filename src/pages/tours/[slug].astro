---
/**
 * Scheda Tour — PROTOTYPE hero compare via ?variant=
 * atelier = current gallery|info (default)
 * prenota = info|Calendly, gallery below
 */
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Base from "../../layouts/Base.astro";
import SchedaTourHeroAtelier from "../../components/scheda-tour/SchedaTourHeroAtelier.astro";
import SchedaTourHeroPrenotaSplit from "../../components/scheda-tour/SchedaTourHeroPrenotaSplit.astro";
import PrototypeVariantSwitcher from "../../components/scheda-tour/PrototypeVariantSwitcher.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: tour, cacheHint } = await getEmDashEntry("tours", slug);

if (!tour) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(tour, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

type TourImage = NonNullable<typeof tour.data.featured_image>;

const galleryImages: TourImage[] = [
	...(tour.data.featured_image ? [tour.data.featured_image] : []),
	...(tour.data.gallery ?? [])
		.map((row) => row.image)
		.filter((image): image is TourImage => Boolean(image)),
];

const specs: {
	term: string;
	value: string;
	edit?: Record<string, unknown>;
}[] = [];
if (tour.data.destination) {
	specs.push({
		term: "Luogo",
		value: tour.data.destination,
		edit: tour.edit.destination,
	});
}
if (tour.data.duration) {
	specs.push({
		term: "Durata",
		value: tour.data.duration,
		edit: tour.edit.duration,
	});
}
if (tour.data.group_size) {
	specs.push({
		term: "Gruppo",
		value: tour.data.group_size,
		edit: tour.edit.group_size,
	});
}
if (tour.data.language) {
	specs.push({
		term: "Lingua",
		value: tour.data.language,
		edit: tour.edit.language,
	});
}
if (tour.data.included) {
	specs.push({
		term: "Incluso",
		value: tour.data.included,
		edit: tour.edit.included,
	});
}
if (tour.data.price) {
	specs.push({
		term: "Prezzo",
		value: tour.data.price,
		edit: tour.edit.price,
	});
}

const faqItems = (tour.data.faq ?? []).filter(
	(row): row is { question: string; answer: string } =>
		Boolean(row?.question && row?.answer),
);

const calendlyUrl =
	typeof tour.data.calendly_url === "string"
		? tour.data.calendly_url.trim()
		: "";

const heroVariants = [
	{ key: "atelier", label: "Atelier gallery|info" },
	{ key: "prenota", label: "Info|Calendly split" },
] as const;

const variantParam = Astro.url.searchParams.get("variant");
const heroVariant =
	variantParam === "prenota" ? "prenota" : ("atelier" as const);

const heroProps = {
	title: tour.data.title,
	destination: tour.data.destination ?? undefined,
	price: tour.data.price ?? undefined,
	excerpt: tour.data.excerpt ?? undefined,
	galleryImages,
	specs,
	calendlyUrl,
	edit: {
		title: tour.edit.title,
		destination: tour.edit.destination,
		price: tour.edit.price,
		excerpt: tour.edit.excerpt,
		featured_image: tour.edit.featured_image,
		calendly_url: tour.edit.calendly_url,
	},
};
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "tours", id: tour.data.id, slug }}
>
	<article class="shell scheda-tour">
		{
			heroVariant === "prenota" ? (
				<SchedaTourHeroPrenotaSplit {...heroProps}>
					{tour.data.content && (
						<section
							class="scheda-tour__content"
							aria-labelledby="tour-content-heading"
							{...tour.edit.content}
						>
							<h2 id="tour-content-heading" class="type-h3 scheda-tour__content-title">
								Il tour
							</h2>
							<PortableText value={tour.data.content} />
						</section>
					)}
					{faqItems.length > 0 && (
						<section
							class="scheda-tour__faq"
							aria-labelledby="tour-faq-heading"
							{...tour.edit.faq}
						>
							<h2 id="tour-faq-heading" class="type-h3 scheda-tour__faq-title">
								Domande frequenti
							</h2>
							<div class="scheda-tour__faq-list">
								{faqItems.map((item) => (
									<details class="scheda-tour__faq-item">
										<summary>
											<span>{item.question}</span>
											<ChevronDown
												class="scheda-tour__faq-icon"
												size={16}
												stroke-width={1.75}
												aria-hidden="true"
											/>
										</summary>
										<div class="scheda-tour__faq-panel">
											<p class="type-body">{item.answer}</p>
										</div>
									</details>
								))}
							</div>
						</section>
					)}
				</SchedaTourHeroPrenotaSplit>
			) : (
				<>
					<SchedaTourHeroAtelier {...heroProps} />
					{tour.data.content && (
						<section
							class="scheda-tour__content"
							aria-labelledby="tour-content-heading"
							{...tour.edit.content}
						>
							<h2 id="tour-content-heading" class="type-h3 scheda-tour__content-title">
								Il tour
							</h2>
							<PortableText value={tour.data.content} />
						</section>
					)}
					{faqItems.length > 0 && (
						<section
							class="scheda-tour__faq"
							aria-labelledby="tour-faq-heading"
							{...tour.edit.faq}
						>
							<h2 id="tour-faq-heading" class="type-h3 scheda-tour__faq-title">
								Domande frequenti
							</h2>
							<div class="scheda-tour__faq-list">
								{faqItems.map((item) => (
									<details class="scheda-tour__faq-item">
										<summary>
											<span>{item.question}</span>
											<ChevronDown
												class="scheda-tour__faq-icon"
												size={16}
												stroke-width={1.75}
												aria-hidden="true"
											/>
										</summary>
										<div class="scheda-tour__faq-panel">
											<p class="type-body">{item.answer}</p>
										</div>
									</details>
								))}
							</div>
						</section>
					)}
				</>
			)
		}
	</article>

	<PrototypeVariantSwitcher
		variants={[...heroVariants]}
		current={heroVariant}
	/>
</Base>

<style>
	.scheda-tour {
		padding-block: 0 4rem;
	}

	.scheda-tour__content {
		margin-top: 4rem;
		max-width: var(--measure);
		font-size: 1rem;
		color: var(--muted);
	}

	.scheda-tour__content-title,
	.scheda-tour__faq-title {
		margin: 0;
		color: var(--title);
	}

	/* Content body has no top padding; FAQ summary has 1rem — compensate so gaps match. */
	.scheda-tour__content-title {
		margin-bottom: 1.25rem;
	}

	.scheda-tour__faq-title {
		margin-bottom: 0.25rem;
	}

	.scheda-tour__content :global(p) {
		margin-bottom: 1.1em;
	}

	.scheda-tour__content :global(h2:not(.scheda-tour__content-title)),
	.scheda-tour__content :global(h3) {
		color: var(--title);
		margin: 1.6em 0 0.5em;
	}

	.scheda-tour__faq {
		margin-top: 4rem;
		max-width: var(--measure);
	}

	.scheda-tour__faq-list {
		display: grid;
		gap: 0;
	}

	.scheda-tour__faq-item {
		border-bottom: 1px solid var(--line);
	}

	.scheda-tour__faq-item:last-child {
		border-bottom: 0;
	}

	.scheda-tour__faq-item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		list-style: none;
		padding-block: 1rem;
		font-family: var(--font-body);
		font-size: 1rem;
		letter-spacing: 0;
		color: var(--ink);
	}

	.scheda-tour__faq-item summary::-webkit-details-marker {
		display: none;
	}

	.scheda-tour__faq-icon {
		flex-shrink: 0;
		color: var(--muted);
		transition: transform 200ms ease;
	}

	.scheda-tour__faq-item[open] .scheda-tour__faq-icon {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.scheda-tour__faq-icon {
			transition: none;
		}
	}

	.scheda-tour__faq-panel {
		overflow: hidden;
	}

	.scheda-tour__faq-item p {
		margin: 0 0 1.25rem;
		font-size: 1rem;
		color: var(--muted);
	}
</style>

<script>
	import { animate } from "animejs";

	const reduceMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	document.querySelectorAll(".scheda-tour__faq-item").forEach((node) => {
		if (!(node instanceof HTMLDetailsElement)) return;
		const panel = node.querySelector(".scheda-tour__faq-panel");
		if (!(panel instanceof HTMLElement)) return;
		if (node.dataset.faqAnim === "1") return;
		node.dataset.faqAnim = "1";
		if (reduceMotion) return;

		let busy = false;

		node.addEventListener("click", (event) => {
			const summary = node.querySelector("summary");
			if (
				!summary ||
				!(event.target instanceof Node) ||
				!summary.contains(event.target)
			) {
				return;
			}
			event.preventDefault();
			if (busy) return;
			busy = true;

			if (node.open) {
				const from = panel.getBoundingClientRect().height;
				panel.style.height = `${from}px`;
				animate(panel, {
					height: "0px",
					duration: 280,
					ease: "outQuart",
					onComplete: () => {
						node.open = false;
						panel.style.height = "";
						busy = false;
					},
				});
				return;
			}

			node.open = true;
			const to = panel.scrollHeight;
			panel.style.height = "0px";
			animate(panel, {
				height: `${to}px`,
				duration: 320,
				ease: "outExpo",
				onComplete: () => {
					panel.style.height = "";
					busy = false;
				},
			});
		});
	});
</script>
