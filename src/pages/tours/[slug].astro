---
/**
 * Scheda Tour — PROTOTYPE hero compare via ?variant=
 * atelier = current gallery|info (default)
 * prenota = info|Calendly, gallery below
 */
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import SchedaTourHeroAtelier from "../../components/scheda-tour/SchedaTourHeroAtelier.astro";
import SchedaTourHeroPrenotaSplit from "../../components/scheda-tour/SchedaTourHeroPrenotaSplit.astro";
import PrototypeVariantSwitcher from "../../components/scheda-tour/PrototypeVariantSwitcher.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: tour, cacheHint } = await getEmDashEntry("tours", slug);

if (!tour) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(tour, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

type TourImage = NonNullable<typeof tour.data.featured_image>;

const galleryImages: TourImage[] = [
	...(tour.data.featured_image ? [tour.data.featured_image] : []),
	...(tour.data.gallery ?? [])
		.map((row) => row.image)
		.filter((image): image is TourImage => Boolean(image)),
];

const specs: {
	term: string;
	value: string;
	edit?: Record<string, unknown>;
}[] = [];
if (tour.data.destination) {
	specs.push({
		term: "Luogo",
		value: tour.data.destination,
		edit: tour.edit.destination,
	});
}
if (tour.data.duration) {
	specs.push({
		term: "Durata",
		value: tour.data.duration,
		edit: tour.edit.duration,
	});
}
if (tour.data.group_size) {
	specs.push({
		term: "Gruppo",
		value: tour.data.group_size,
		edit: tour.edit.group_size,
	});
}
if (tour.data.language) {
	specs.push({
		term: "Lingua",
		value: tour.data.language,
		edit: tour.edit.language,
	});
}
if (tour.data.included) {
	specs.push({
		term: "Incluso",
		value: tour.data.included,
		edit: tour.edit.included,
	});
}
if (tour.data.price) {
	specs.push({
		term: "Prezzo",
		value: tour.data.price,
		edit: tour.edit.price,
	});
}

const faqItems = (tour.data.faq ?? []).filter(
	(row): row is { question: string; answer: string } =>
		Boolean(row?.question && row?.answer),
);

const calendlyUrl =
	typeof tour.data.calendly_url === "string"
		? tour.data.calendly_url.trim()
		: "";

const heroVariants = [
	{ key: "atelier", label: "Atelier gallery|info" },
	{ key: "prenota", label: "Info|Calendly split" },
] as const;

const variantParam = Astro.url.searchParams.get("variant");
const heroVariant =
	variantParam === "prenota" ? "prenota" : ("atelier" as const);

const heroProps = {
	title: tour.data.title,
	destination: tour.data.destination ?? undefined,
	price: tour.data.price ?? undefined,
	excerpt: tour.data.excerpt ?? undefined,
	galleryImages,
	specs,
	calendlyUrl,
	edit: {
		title: tour.edit.title,
		destination: tour.edit.destination,
		price: tour.edit.price,
		excerpt: tour.edit.excerpt,
		featured_image: tour.edit.featured_image,
		calendly_url: tour.edit.calendly_url,
	},
};
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "tours", id: tour.data.id, slug }}
>
	<article class="shell scheda-tour">
		{
			heroVariant === "prenota" ? (
				<SchedaTourHeroPrenotaSplit {...heroProps}>
					{tour.data.content && (
						<div class="scheda-tour__content" {...tour.edit.content}>
							<PortableText value={tour.data.content} />
						</div>
					)}
					{faqItems.length > 0 && (
						<section
							class="scheda-tour__faq"
							aria-labelledby="tour-faq-heading"
							{...tour.edit.faq}
						>
							<h2 id="tour-faq-heading" class="type-h3 scheda-tour__faq-title">
								Domande frequenti
							</h2>
							<div class="scheda-tour__faq-list">
								{faqItems.map((item) => (
									<details class="scheda-tour__faq-item">
										<summary>{item.question}</summary>
										<p class="type-body">{item.answer}</p>
									</details>
								))}
							</div>
						</section>
					)}
				</SchedaTourHeroPrenotaSplit>
			) : (
				<>
					<SchedaTourHeroAtelier {...heroProps} />
					{tour.data.content && (
						<div class="scheda-tour__content" {...tour.edit.content}>
							<PortableText value={tour.data.content} />
						</div>
					)}
					{faqItems.length > 0 && (
						<section
							class="scheda-tour__faq"
							aria-labelledby="tour-faq-heading"
							{...tour.edit.faq}
						>
							<h2 id="tour-faq-heading" class="type-h3 scheda-tour__faq-title">
								Domande frequenti
							</h2>
							<div class="scheda-tour__faq-list">
								{faqItems.map((item) => (
									<details class="scheda-tour__faq-item">
										<summary>{item.question}</summary>
										<p class="type-body">{item.answer}</p>
									</details>
								))}
							</div>
						</section>
					)}
				</>
			)
		}
	</article>

	<PrototypeVariantSwitcher
		variants={[...heroVariants]}
		current={heroVariant}
	/>
</Base>

<style>
	.scheda-tour {
		padding-block: 0 4rem;
	}

	.scheda-tour__content {
		margin-top: 4rem;
		max-width: var(--measure);
		color: var(--muted);
	}

	.scheda-tour__content :global(p) {
		margin-bottom: 1.1em;
	}

	.scheda-tour__content :global(h2),
	.scheda-tour__content :global(h3) {
		color: var(--title);
		margin: 1.6em 0 0.5em;
	}

	.scheda-tour__faq {
		margin-top: 4rem;
		max-width: var(--measure);
		border-top: 1px solid var(--line);
		padding-top: 2.5rem;
	}

	.scheda-tour__faq-title {
		margin: 0 0 1.25rem;
		color: var(--title);
	}

	.scheda-tour__faq-list {
		display: grid;
		gap: 0;
	}

	.scheda-tour__faq-item {
		border-bottom: 1px solid var(--line);
	}

	.scheda-tour__faq-item summary {
		cursor: pointer;
		list-style: none;
		padding-block: 1rem;
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		color: var(--ink);
	}

	.scheda-tour__faq-item summary::-webkit-details-marker {
		display: none;
	}

	.scheda-tour__faq-item summary::before {
		content: "▼ ";
		color: var(--muted);
		font-size: 0.65em;
	}

	.scheda-tour__faq-item[open] summary::before {
		content: "▲ ";
	}

	.scheda-tour__faq-item p {
		margin: 0 0 1.25rem;
		max-width: 46ch;
		color: var(--muted);
	}
</style>
