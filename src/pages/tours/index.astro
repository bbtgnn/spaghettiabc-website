---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import TourLargeCard from "../../components/TourLargeCard.astro";
import {
	getEmDashEntryWithFallback,
	entrySlug,
	localePath,
	resolveLocale,
	t,
} from "../../i18n/utils";

const locale = resolveLocale(Astro.currentLocale);
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entry: home, cacheHint: homeCacheHint } =
	await getEmDashEntryWithFallback("homepage", "home", {
		locale,
		references: { featured_tours: true },
	});
const {
	entries: tourEntries,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("tours", {
	orderBy: { published_at: "asc" },
	limit: 40,
	cursor,
	locale,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(homeCacheHint);
}

/** Same curated order as homepage Sezione Tour (`featured_tours`), then any extras. */
const featuredOrder = new Map(
	(home?.references?.featured_tours?.entries ?? []).map((tour, index) => [
		tour.id,
		index,
	]),
);
const tours = [...tourEntries].sort((a, b) => {
	const rankA = featuredOrder.get(a.id) ?? Number.POSITIVE_INFINITY;
	const rankB = featuredOrder.get(b.id) ?? Number.POSITIVE_INFINITY;
	if (rankA !== rankB) return rankA - rankB;
	return (a.data.title ?? "").localeCompare(
		b.data.title ?? "",
		locale === "it" ? "it" : "en",
	);
});

const highlightTours = tours.slice(0, 2);
const gridTours = tours.slice(2);

const pageTitle = t(locale, "tourCatalogTitle");
const pageDescription = t(locale, "tourCatalogLede");
const toursIndexHref = localePath(locale, "/tours");
---

<Base title={pageTitle} description={pageDescription}>
	<section class="shell tours-catalog">
		<header class="tours-catalog__intro">
			<h1 class="type-hero">{pageTitle}</h1>
			<p class="type-lead tours-catalog__lede">{pageDescription}</p>
		</header>

		{
			tours.length === 0 ? (
				<p class="type-body tours-catalog__empty">
					{t(locale, "tourCatalogEmpty")}{" "}
					<a class="link" href="/_emdash/admin/content/tours/new">
						{t(locale, "tourCatalogCreate")}
					</a>
					.
				</p>
			) : (
				<>
					{highlightTours.length > 0 && (
						<div class="tour-highlight">
							{highlightTours.map((tour, index) => (
								<TourLargeCard
									href={localePath(locale, `/tours/${entrySlug(tour.id)}`)}
									title={tour.data.title}
									excerpt={tour.data.excerpt}
									image={tour.data.featured_image}
									showCta={false}
									index={index}
									locale={locale}
								/>
							))}
						</div>
					)}

					{gridTours.length > 0 && (
						<div class="tour-grid">
							{gridTours.map((tour, index) => (
								<TourLargeCard
									href={localePath(locale, `/tours/${entrySlug(tour.id)}`)}
									title={tour.data.title}
									excerpt={tour.data.excerpt}
									image={tour.data.featured_image}
									showCta={false}
									index={index + highlightTours.length}
									locale={locale}
								/>
							))}
						</div>
					)}
				</>
			)
		}

		{
			(cursor || nextCursor) && (
				<nav class="tours-catalog__pager" aria-label={t(locale, "tourPagination")}>
					{cursor && (
						<a class="text-link" href={toursIndexHref}>
							{t(locale, "tourFirstPage")}
						</a>
					)}
					{nextCursor && (
						<a
							class="text-link"
							href={`${toursIndexHref}?cursor=${encodeURIComponent(nextCursor)}`}
						>
							{t(locale, "tourNextPage")}
						</a>
					)}
				</nav>
			)
		}
	</section>
</Base>

<style>
	.tours-catalog {
		padding-block: 2.5rem 4rem;
	}

	.tours-catalog__intro {
		display: grid;
		gap: 1.25rem;
	}

	.tours-catalog__intro .type-hero,
	.tours-catalog__lede {
		text-wrap: nowrap;
		white-space: nowrap;
	}

	@media (max-width: 639px) {
		.tours-catalog__intro .type-hero,
		.tours-catalog__lede {
			text-wrap: balance;
			white-space: normal;
		}
	}

	.tours-catalog__empty {
		margin-top: 3rem;
	}

	.tours-catalog__pager {
		margin-top: 3rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
	}
</style>
