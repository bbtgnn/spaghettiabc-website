---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import Base from "../../layouts/Base.astro";
import TourTeaser from "../../components/TourTeaser.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entry: home, cacheHint: homeCacheHint } = await getEmDashEntry(
	"homepage",
	"home",
	{ references: { featured_tours: true } },
);
const {
	entries: tourEntries,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("tours", {
	orderBy: { published_at: "asc" },
	limit: 40,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(homeCacheHint);
}

/** Same curated order as homepage Sezione Tour (`featured_tours`), then any extras. */
const featuredOrder = new Map(
	(home?.references?.featured_tours?.entries ?? []).map((tour, index) => [
		tour.id,
		index,
	]),
);
const tours = [...tourEntries].sort((a, b) => {
	const rankA = featuredOrder.get(a.id) ?? Number.POSITIVE_INFINITY;
	const rankB = featuredOrder.get(b.id) ?? Number.POSITIVE_INFINITY;
	if (rankA !== rankB) return rankA - rankB;
	return (a.data.title ?? "").localeCompare(b.data.title ?? "", "it");
});

const pageTitle = "Catalogo tour";
const pageDescription =
	"Tour guidati in Puglia, un paese alla volta, per scoprire i sapori locali.";
---

<Base title={pageTitle} description={pageDescription} paletteSlot="page-tours">
	<section class="shell tours-catalog">
		<header class="tours-catalog__intro">
			<h1 class="type-hero">{pageTitle}</h1>
			<p class="type-lead tours-catalog__lede">{pageDescription}</p>
		</header>

		{
			tours.length === 0 ? (
				<p class="type-body tours-catalog__empty">
					Nessun tour ancora.{" "}
					<a class="link" href="/_emdash/admin/content/tours/new">Creane uno</a>.
				</p>
			) : (
				<div class="tour-grid">
					{tours.map((tour, index) => (
						<TourTeaser
							href={`/tours/${tour.id}`}
							title={tour.data.title}
							excerpt={tour.data.excerpt}
							destination={tour.data.destination}
							duration={tour.data.duration}
							price={tour.data.price}
							image={tour.data.featured_image}
							edit={tour.edit}
							index={index}
						/>
					))}
				</div>
			)
		}

		{
			(cursor || nextCursor) && (
				<nav class="tours-catalog__pager" aria-label="Paginazione">
					{cursor && <a class="text-link" href="/tours">Prima pagina</a>}
					{nextCursor && (
						<a class="text-link" href={`/tours?cursor=${encodeURIComponent(nextCursor)}`}>
							Pagina successiva
						</a>
					)}
				</nav>
			)
		}
	</section>
</Base>

<style>
	.tours-catalog {
		padding-block: 2.5rem 4rem;
	}

	.tours-catalog__intro {
		display: grid;
		gap: 1.25rem;
	}

	.tours-catalog__intro .type-hero,
	.tours-catalog__lede {
		text-wrap: nowrap;
		white-space: nowrap;
	}

	@media (max-width: 639px) {
		.tours-catalog__intro .type-hero,
		.tours-catalog__lede {
			text-wrap: balance;
			white-space: normal;
		}
	}

	.tours-catalog__empty {
		margin-top: 3rem;
	}

	.tours-catalog__pager {
		margin-top: 3rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
	}
</style>
