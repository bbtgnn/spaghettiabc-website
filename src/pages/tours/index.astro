---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: tours,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("tours", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Tour">
	<h1>Tour</h1>

	{
		tours.length === 0 ? (
			<p>
				Nessun tour ancora.{" "}
				<a href="/_emdash/admin/content/tours/new">Creane uno</a>.
			</p>
		) : (
			<ul>
				{tours.map((tour) => (
					<li>
						<a href={`/tours/${tour.id}`}>
							{tour.data.featured_image && (
								<div {...tour.edit.featured_image}>
									<Image image={tour.data.featured_image} />
								</div>
							)}
							<h2 {...tour.edit.title}>{tour.data.title}</h2>
						</a>
						{tour.data.excerpt && (
							<p {...tour.edit.excerpt}>{tour.data.excerpt}</p>
						)}
						{(tour.data.destination ||
							tour.data.duration ||
							tour.data.price) && (
							<p>
								{[tour.data.destination, tour.data.duration, tour.data.price]
									.filter(Boolean)
									.join(" · ")}
							</p>
						)}
					</li>
				))}
			</ul>
		)
	}

	<nav aria-label="Pagination">
		{cursor && <a href="/tours">Prima pagina</a>}
		{
			nextCursor && (
				<a href={`/tours?cursor=${encodeURIComponent(nextCursor)}`}>
					Pagina successiva
				</a>
			)
		}
	</nav>
</Base>
