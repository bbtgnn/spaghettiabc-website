---
import { getEmDashEntry, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import TourTeaser from "../components/TourTeaser.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entry: home, cacheHint } = await getEmDashEntry("homepage", "home", {
	references: { featured_tours: true },
});
const { entry: collaborations, cacheHint: collaborationsCacheHint } =
	await getEmDashEntry("collaborations", "collaborazioni");
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(collaborationsCacheHint);
}

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);

const featuredTours = home?.references?.featured_tours?.entries ?? [];
const collaborationLogos = collaborations?.data.logos ?? [];
const collaborationTestimonials = collaborations?.data.testimonials ?? [];
const pageTitle = home?.data.hero_title ?? siteTitle;
const pageDescription = home?.data.hero_subtitle ?? siteTagline;

const facts = [
	{ value: String(featuredTours.length).padStart(2, "0"), label: "Tour" },
	{ value: "Puglia", label: "Base" },
	{ value: "Book", label: "Guida" },
	{ value: "Formazione", label: "Training" },
];
---

<Base title={pageTitle} description={pageDescription}>
	{
		home ? (
			<>
				<section class="shell hero">
					<div class="hero__copy hero-in">
						<h1 class="type-hero" {...home.edit.hero_title}>
							{home.data.hero_title}
						</h1>
						{home.data.hero_subtitle && (
							<p class="type-lead hero__lede" {...home.edit.hero_subtitle}>
								{home.data.hero_subtitle}
							</p>
						)}
						<div class="hero__actions">
							{home.data.tour_cta_label && (
								<a class="btn btn-primary" href="/tours" {...home.edit.tour_cta_label}>
									{home.data.tour_cta_label}
								</a>
							)}
							<a class="btn btn-outline" href="/puglia-the-book">
								Il libro
							</a>
						</div>
					</div>

					{home.data.hero_image && (
						<figure class="hero__figure hero-in" style="--reveal-delay:120ms">
							<div class="hero__frame">
								<div class="parallax" {...home.edit.hero_image}>
									<Image image={home.data.hero_image} />
								</div>
							</div>
							<figcaption class="mono hero__caption">
								<span>{siteTitle}</span>
								<span>Puglia · Italia</span>
							</figcaption>
						</figure>
					)}
				</section>

				<div class="facts-band">
					<dl class="shell facts-band__grid">
						{facts.map((fact, index) => (
							<div
								class="fact"
								data-reveal
								style={`--reveal-delay:${index * 70}ms`}
							>
								<dt class="label">{fact.label}</dt>
								<dd class="facts-band__value">{fact.value}</dd>
							</div>
						))}
					</dl>
				</div>

				<section class="shell section">
					<div class="rule" data-reveal="line" />
					<div class="section__head" data-reveal>
						<h2 class="type-h2" {...home.edit.tour_title}>
							{home.data.tour_title}
						</h2>
						{home.data.tour_cta_label && (
							<a class="link link-mono" href="/tours" {...home.edit.tour_cta_label}>
								Tutti i tour
							</a>
						)}
					</div>
					{home.data.tour_subtitle && (
						<p class="type-lead section__lede" data-reveal {...home.edit.tour_subtitle}>
							{home.data.tour_subtitle}
						</p>
					)}

					{featuredTours.length === 0 ? (
						<p class="type-body" data-reveal>Nessun tour in evidenza.</p>
					) : (
						<div class="tour-grid">
							{featuredTours.map((tour, index) => (
								<TourTeaser
									href={`/tours/${tour.id}`}
									title={tour.data.title}
									excerpt={tour.data.excerpt}
									destination={tour.data.destination}
									duration={tour.data.duration}
									price={tour.data.price}
									image={tour.data.featured_image}
									index={index}
								/>
							))}
						</div>
					)}
				</section>

				<section class="shell section feature">
					<div class="rule" data-reveal="line" />
					<div class="feature__layout">
						{home.data.book_image && (
							<a
								href="/puglia-the-book"
								class="feature__media"
								data-reveal="mask"
								aria-label={home.data.book_title ?? "Il libro"}
							>
								<div {...home.edit.book_image}>
									<Image image={home.data.book_image} />
								</div>
							</a>
						)}
						<div class="feature__copy" data-reveal>
							{home.data.book_title && (
								<h2 class="type-h2" {...home.edit.book_title}>
									{home.data.book_title}
								</h2>
							)}
							{home.data.book_subtitle && (
								<p class="type-lead" {...home.edit.book_subtitle}>
									{home.data.book_subtitle}
								</p>
							)}
							{home.data.book_cta_label && (
								<a class="link link-mono" href="/puglia-the-book" {...home.edit.book_cta_label}>
									{home.data.book_cta_label}
								</a>
							)}
						</div>
					</div>
				</section>

				<section class="shell section feature feature--flip">
					<div class="rule" data-reveal="line" />
					<div class="feature__layout">
						{home.data.training_image && (
							<a
								href="/training"
								class="feature__media"
								data-reveal="mask"
								aria-label={home.data.training_title ?? "Training"}
							>
								<div {...home.edit.training_image}>
									<Image image={home.data.training_image} />
								</div>
							</a>
						)}
						<div class="feature__copy" data-reveal>
							{home.data.training_title && (
								<h2 class="type-h2" {...home.edit.training_title}>
									{home.data.training_title}
								</h2>
							)}
							{home.data.training_subtitle && (
								<p class="type-lead" {...home.edit.training_subtitle}>
									{home.data.training_subtitle}
								</p>
							)}
							{home.data.training_cta_label && (
								<a class="link link-mono" href="/training" {...home.edit.training_cta_label}>
									{home.data.training_cta_label}
								</a>
							)}
						</div>
					</div>
				</section>

				<section class="shell section">
					<div class="rule" data-reveal="line" />
					<div class="section__head" data-reveal>
						{home.data.collaborations_title && (
							<h2 class="type-h2" {...home.edit.collaborations_title}>
								{home.data.collaborations_title}
							</h2>
						)}
						{home.data.collaborations_cta_label && (
							<a
								class="link link-mono"
								href="/collaborazioni"
								{...home.edit.collaborations_cta_label}
							>
								{home.data.collaborations_cta_label}
							</a>
						)}
					</div>
					{home.data.collaborations_subtitle && (
						<p
							class="type-lead section__lede"
							data-reveal
							{...home.edit.collaborations_subtitle}
						>
							{home.data.collaborations_subtitle}
						</p>
					)}

					{collaborationLogos.length > 0 && (
						<ul class="logo-row" data-reveal {...collaborations?.edit.logos}>
							{collaborationLogos.map((item) => (
								<li class="logo-row__item">
									{item.logo && <Image image={item.logo} />}
									{item.name && <span class="visually-hidden">{item.name}</span>}
								</li>
							))}
						</ul>
					)}

					{collaborationTestimonials.length > 0 && (
						<ul
							class="quote-list"
							data-reveal
							{...collaborations?.edit.testimonials}
						>
							{collaborationTestimonials.map((item) => {
								const rating = Number(item.rating) || 5;
								return (
									<li class="quote">
										<p class="mono quote__rating" aria-label={`Valutazione: ${rating} su 5`}>
											{String(rating).padStart(2, "0")} / 05
										</p>
										<blockquote class="type-lead quote__text">
											<p>{item.quote}</p>
										</blockquote>
										<p class="quote__author">
											<span>{item.author}</span>
											{item.role_or_company && (
												<span class="label">{item.role_or_company}</span>
											)}
										</p>
									</li>
								);
							})}
						</ul>
					)}
				</section>

				<section class="newsletter" aria-labelledby="newsletter-heading">
					<div class="shell newsletter__inner">
						{home.data.newsletter_title && (
							<h2
								id="newsletter-heading"
								class="type-h2"
								data-reveal
								{...home.edit.newsletter_title}
							>
								{home.data.newsletter_title}
							</h2>
						)}
						{home.data.newsletter_subtitle && (
							<p class="type-lead newsletter__lede" data-reveal {...home.edit.newsletter_subtitle}>
								{home.data.newsletter_subtitle}
							</p>
						)}

						<form class="newsletter-form" id="newsletter-form" novalidate data-reveal>
							<label class="field-label" for="newsletter-email">Email</label>
							<div class="newsletter-field">
								<input
									type="email"
									id="newsletter-email"
									name="email"
									autocomplete="email"
									placeholder={home.data.newsletter_email_placeholder ?? "La tua email"}
									{...home.edit.newsletter_email_placeholder}
								/>
								<button
									class="btn btn-primary"
									type="submit"
									{...home.edit.newsletter_button_label}
								>
									{home.data.newsletter_button_label ?? "Iscriviti"}
								</button>
							</div>
							<p
								class="newsletter-form__status"
								id="newsletter-status"
								role="status"
								aria-live="polite"
								hidden
							/>
						</form>
						<p class="label newsletter__note">
							L’iscrizione non è ancora attiva: per ora nessun dato viene inviato.
						</p>
					</div>
				</section>
			</>
		) : (
			<section class="shell section">
				<p class="type-body">
					Homepage non configurata.{" "}
					<a class="link" href="/_emdash/admin/content/homepage">Apri l’admin</a>.
				</p>
			</section>
		)
	}
</Base>

<style>
	.hero {
		display: grid;
		align-items: center;
		gap: 2.5rem 3rem;
		padding-block: 2rem 1rem;
	}

	@media (min-width: 900px) {
		.hero {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			padding-block: 3rem 2.5rem;
		}
	}

	.hero__lede {
		margin-top: 1.75rem;
		max-width: 42ch;
	}

	.hero__actions {
		margin-top: 2.25rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hero__frame {
		overflow: hidden;
		background: var(--surface);
	}

	.hero__frame :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	@media (min-width: 900px) {
		.hero__frame :global(img) {
			aspect-ratio: 8 / 7;
		}
	}

	.hero__caption {
		margin-top: 0.75rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.625rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.facts-band {
		margin-top: 3.5rem;
		border-block: 1px solid var(--line);
	}

	@media (min-width: 768px) {
		.facts-band {
			margin-top: 5rem;
		}
	}

	.facts-band__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	@media (min-width: 768px) {
		.facts-band__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.facts-band__value {
		margin: 0.65rem 0 0;
		font-size: clamp(1.5rem, 2.5vw, 1.875rem);
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.section {
		padding-block: 6rem 0;
	}

	@media (min-width: 768px) {
		.section {
			padding-block: 9rem 0;
		}
	}

	.section__head {
		margin-top: 2rem;
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 1rem 2rem;
	}

	.section__head .type-h2 {
		max-width: 14ch;
	}

	.section__lede {
		margin-top: 1.25rem;
		max-width: 48ch;
	}

	.tour-grid {
		margin-top: 3rem;
		display: grid;
		gap: 3.5rem 2rem;
	}

	@media (min-width: 768px) {
		.tour-grid {
			margin-top: 3.5rem;
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.feature {
		padding-bottom: 0;
	}

	.feature__layout {
		margin-top: 2.5rem;
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 900px) {
		.feature__layout {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			gap: 3rem;
		}

		.feature--flip .feature__media {
			order: 2;
		}

		.feature--flip .feature__copy {
			order: 1;
		}
	}

	.feature__media {
		display: block;
		overflow: hidden;
		background: var(--surface);
	}

	.feature__media :global(img) {
		width: 100%;
		aspect-ratio: 5 / 4;
		object-fit: cover;
		transition: transform 1100ms var(--ease-out-expo);
	}

	.feature__media:hover :global(img) {
		transform: scale(1.04);
	}

	.feature__copy {
		display: grid;
		gap: 1.25rem;
		align-content: start;
	}

	.logo-row {
		margin-top: 2.5rem;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		background: var(--line);
		border: 1px solid var(--line);
	}

	@media (min-width: 768px) {
		.logo-row {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.logo-row__item {
		display: grid;
		place-items: center;
		min-height: 5rem;
		padding: 1rem;
		background: var(--canvas);
	}

	.logo-row__item :global(img) {
		max-height: 2.5rem;
		width: auto;
		max-width: 100%;
		object-fit: contain;
		filter: grayscale(1);
		opacity: 0.7;
	}

	.quote-list {
		margin-top: 3rem;
		display: grid;
		gap: 2rem;
	}

	@media (min-width: 768px) {
		.quote-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2.5rem 3rem;
		}
	}

	.quote {
		display: grid;
		gap: 1rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
	}

	.quote__rating {
		font-size: 0.6875rem;
		color: var(--muted);
	}

	.quote__text {
		margin: 0;
	}

	.quote__author {
		display: grid;
		gap: 0.35rem;
		font-weight: 500;
	}

	.newsletter {
		margin-top: 6rem;
		padding-block: 5rem;
		border-top: 1px solid var(--line);
		text-align: center;
	}

	@media (min-width: 768px) {
		.newsletter {
			margin-top: 9rem;
			padding-block: 7rem;
		}
	}

	.newsletter__inner {
		display: grid;
		justify-items: center;
		gap: 1.25rem;
	}

	.newsletter__lede {
		max-width: 40ch;
	}

	.newsletter-form {
		width: min(100%, 28rem);
		display: grid;
		gap: 0.65rem;
		margin-top: 1rem;
	}

	.newsletter-form__status {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.newsletter__note {
		margin-top: 0.5rem;
	}
</style>

<script>
	const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
	const status = document.getElementById("newsletter-status");
	if (form && status) {
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const email = new FormData(form).get("email");
			if (!email || typeof email !== "string" || !email.includes("@")) {
				status.hidden = false;
				status.textContent = "Inserisci un’email valida.";
				return;
			}
			status.hidden = false;
			status.textContent = "Grazie — iscrizione non ancora collegata.";
			const button = form.querySelector('button[type="submit"]');
			if (button instanceof HTMLButtonElement) button.disabled = true;
		});
	}
</script>
