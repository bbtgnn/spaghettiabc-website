---
import { getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Base from "../layouts/Base.astro";
import PartnerLogoMarquee from "../components/PartnerLogoMarquee.astro";
import SezioneTour from "../components/SezioneTour.astro";
import {
	entrySlug,
	getEmDashEntryWithFallback,
	localePath,
	resolveLocale,
	t,
} from "../i18n/utils";
import { getTourGoogleSocialProof } from "../utils/tour-google-social-proof";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const locale = resolveLocale(Astro.currentLocale);
const { entry: home, cacheHint } = await getEmDashEntryWithFallback(
	"homepage",
	"home",
	{
		locale,
		references: { featured_tours: true, featured_books: true },
	},
);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
}

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);

const featuredTours = home?.references?.featured_tours?.entries ?? [];
const books = home?.references?.featured_books?.entries ?? [];
const bookCtaLabel =
	home?.data.book_cta_label?.trim() || t(locale, "tourDiscover");
const partnerLogos = home?.data.partner_logos ?? [];
const googleSocialProof = await getTourGoogleSocialProof(
	Astro.locals,
	Astro.request,
);
const pageTitle = home?.data.hero_title ?? siteTitle;
const pageDescription = home?.data.hero_subtitle ?? siteTagline;

const toursHref = localePath(locale, "/tours");
const bookHref = `${localePath(locale, "/")}#libro`;
const trainingHref = localePath(locale, "/training");
---

<Base
	title={pageTitle}
	description={pageDescription}
	content={home
		? { collection: "homepage", id: home.data.id, slug: home.id }
		: undefined}
>
	{
		home ? (
			<>
				<section class="shell hero">
					<div class="hero__copy hero-in">
						<h1 class="type-hero" {...home.edit.hero_title}>
							{home.data.hero_title}
						</h1>
						{home.data.hero_subtitle && (
							<p class="type-lead hero__lede" {...home.edit.hero_subtitle}>
								{home.data.hero_subtitle}
							</p>
						)}
						<div class="hero__actions">
							{home.data.tour_cta_label && (
								<a class="btn btn-primary" href={toursHref} {...home.edit.tour_cta_label}>
									{home.data.tour_cta_label}
								</a>
							)}
							<a class="btn btn-outline" href={bookHref}>
								{t(locale, "heroBookCta")}
							</a>
						</div>
					</div>

					{home.data.hero_image && (
						<figure class="hero__figure hero-in" style="--reveal-delay:120ms">
							<div class="hero__frame">
								<div class="parallax" {...home.edit.hero_image}>
									<Image image={home.data.hero_image} />
								</div>
							</div>
							<figcaption class="mono hero__caption">
								<span>{siteTitle}</span>
								<span>Puglia · Italia</span>
							</figcaption>
						</figure>
					)}
				</section>

				<SezioneTour
					title={home.data.tour_title}
					subtitle={home.data.tour_subtitle}
					ctaLabel={home.data.tour_cta_label}
					tours={featuredTours}
					googleSocialProof={googleSocialProof}
					locale={locale}
					edit={{
						tour_title: home.edit.tour_title,
						tour_subtitle: home.edit.tour_subtitle,
						tour_cta_label: home.edit.tour_cta_label,
					}}
				/>

				<section
					id="libro"
					class="shell section sezione-libro"
					aria-labelledby="book-heading"
				>
					<div class="rule" data-reveal="line" />
					<div class="sezione-libro__layout">
						<div class="sezione-libro__intro" data-reveal>
							<div class="sezione-libro__stack">
								{home.data.book_title && (
									<h2 class="type-h2" id="book-heading" {...home.edit.book_title}>
										{home.data.book_title}
									</h2>
								)}
								{home.data.book_subtitle && (
									<p class="type-lead sezione-libro__lede" {...home.edit.book_subtitle}>
										{home.data.book_subtitle}
									</p>
								)}
								<div class="sezione-libro__illust" aria-hidden="true">
									<img
										class="sezione-libro__illust-img"
										src="/illustrations/pomodori.svg"
										alt=""
										width="373"
										height="160"
										loading="lazy"
										decoding="async"
									/>
								</div>
							</div>
						</div>

						{books.length > 0 && (
							<ul
								class="sezione-libro__editions"
								aria-label={t(locale, "libroEditionsList")}
							>
								{books.map((book) => {
									const label = book.data.title;
									const href = localePath(
										locale,
										`/books/${entrySlug(book.id)}`,
									);
									return (
										<li class="sezione-libro__edition">
											{book.data.cover && (
												<a
													class="sezione-libro__cover-link"
													href={href}
													aria-label={label}
												>
													<div class="sezione-libro__cover" {...book.edit.cover}>
														<Image image={book.data.cover} />
													</div>
												</a>
											)}
											<h3 class="sezione-libro__edition-title">
												{label.split(" – ").flatMap((line, i) =>
													i === 0 ? [line] : [<br />, line],
												)}
											</h3>
											<a class="btn btn-primary" href={href}>
												<span {...home.edit.book_cta_label}>{bookCtaLabel}</span>
											</a>
										</li>
									);
								})}
							</ul>
						)}
					</div>
				</section>

				<section class="shell section feature feature--flip">
					<div class="rule" data-reveal="line" />
					<div class="feature__layout">
						<a
							href={trainingHref}
							class="feature__media"
							data-reveal="mask"
							aria-label={home.data.training_title ?? t(locale, "trainingEmptyTitle")}
						>
							{home.data.training_image ? (
								<div {...home.edit.training_image}>
									<Image image={home.data.training_image} />
								</div>
							) : (
								<div
									class="feature__placeholder"
									aria-hidden="true"
									{...home.edit.training_image}
								/>
							)}
						</a>
						<div class="feature__copy" data-reveal>
							{home.data.training_title && (
								<h2 class="type-h2" {...home.edit.training_title}>
									{home.data.training_title}
								</h2>
							)}
							{home.data.training_subtitle && (
								<p class="type-lead" {...home.edit.training_subtitle}>
									{home.data.training_subtitle}
								</p>
							)}
							{home.data.training_cta_label && (
								<a class="btn btn-outline btn--arrow" href={trainingHref} {...home.edit.training_cta_label}>
									<span class="btn__label">{home.data.training_cta_label}</span>
									<ArrowRight class="btn__icon" size={16} stroke-width={1.75} aria-hidden="true" />
								</a>
							)}
						</div>
					</div>
				</section>

				<section class="shell section" aria-labelledby="dicono-heading">
					<div class="rule" data-reveal="line" />
					<div class="section__head" data-reveal>
						{home.data.dicono_title && (
							<h2 class="type-h2" id="dicono-heading" {...home.edit.dicono_title}>
								{home.data.dicono_title}
							</h2>
						)}
					</div>
					{home.data.dicono_subtitle && (
						<p
							class="type-lead section__lede"
							data-reveal
							{...home.edit.dicono_subtitle}
						>
							{home.data.dicono_subtitle}
						</p>
					)}

					{partnerLogos.length > 0 && (
						<div data-reveal {...home.edit.partner_logos}>
							<PartnerLogoMarquee logos={partnerLogos} />
						</div>
					)}
				</section>

				<section class="newsletter" aria-labelledby="newsletter-heading">
					<div class="shell newsletter__inner">
						{home.data.newsletter_title && (
							<h2
								id="newsletter-heading"
								class="type-h2"
								data-reveal
								{...home.edit.newsletter_title}
							>
								{home.data.newsletter_title}
							</h2>
						)}
						{home.data.newsletter_subtitle && (
							<p class="type-lead newsletter__lede" data-reveal {...home.edit.newsletter_subtitle}>
								{home.data.newsletter_subtitle}
							</p>
						)}

						<form class="newsletter-form" id="newsletter-form" novalidate data-reveal>
							<label class="field-label" for="newsletter-email">Email</label>
							<div class="newsletter-field">
								<input
									type="email"
									id="newsletter-email"
									name="email"
									autocomplete="email"
									placeholder={home.data.newsletter_email_placeholder ?? ""}
									{...home.edit.newsletter_email_placeholder}
								/>
								<button
									class="btn btn-primary"
									type="submit"
									{...home.edit.newsletter_button_label}
								>
									{home.data.newsletter_button_label}
								</button>
							</div>
							<p
								class="newsletter-form__status"
								id="newsletter-status"
								role="status"
								aria-live="polite"
								hidden
							/>
						</form>
						<p class="label newsletter__note">
							{t(locale, "newsletterNote")}
						</p>
					</div>
				</section>
			</>
		) : (
			<section class="shell section">
				<p class="type-body">
					{t(locale, "homeMissing")}{" "}
					<a class="link" href="/_emdash/admin/content/homepage">{t(locale, "homeOpenAdmin")}</a>.
				</p>
			</section>
		)
	}
</Base>

<style>
	.hero {
		display: grid;
		align-items: center;
		gap: 2.5rem 3rem;
		padding-block: 2rem 1rem;
	}

	@media (min-width: 900px) {
		.hero {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			padding-block: 3rem 2.5rem;
		}
	}

	.hero__lede {
		margin-top: 1.75rem;
		max-width: 42ch;
	}

	.hero__actions {
		margin-top: 2.25rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hero__frame {
		overflow: hidden;
		background: var(--surface);
	}

	.hero__frame :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	@media (min-width: 900px) {
		.hero__frame :global(img) {
			aspect-ratio: 8 / 7;
		}
	}

	.hero__caption {
		margin-top: 0.75rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: var(--font-ui-size-sm);
		letter-spacing: var(--font-ui-tracking);
		color: var(--muted);
	}

	/* Casing on each span: parent is flex, so ::first-letter would not apply there */
	.hero__caption > span {
		display: inline-block;
	}

	.section {
		padding-block: 0 2.5rem;
	}

	.section__head {
		margin-top: 2rem;
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 1rem 2rem;
	}

	.section__head .type-h2 {
		max-width: 14ch;
	}

	.section__lede {
		margin-top: 1.25rem;
		max-width: 48ch;
	}

	.feature__layout {
		margin-top: 2.5rem;
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 900px) {
		.feature__layout {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			gap: 3rem;
		}

		.feature--flip .feature__media {
			order: 2;
		}

		.feature--flip .feature__copy {
			order: 1;
		}
	}

	.feature__media {
		display: block;
		overflow: hidden;
		background: var(--surface);
	}

	.feature__media :global(img),
	.feature__placeholder {
		width: 100%;
		aspect-ratio: 5 / 4;
		object-fit: cover;
		transition: transform 1100ms var(--ease-out-expo);
	}

	.feature__placeholder {
		background: var(--surface-strong);
	}

	.feature__media:hover :global(img) {
		transform: scale(1.04);
	}

	.feature__copy {
		display: grid;
		gap: 1.25rem;
		align-content: start;
	}

	.feature__copy .type-lead {
		text-wrap: balance;
	}

	.sezione-libro {
		scroll-margin-top: 5rem;
		position: relative;
		overflow: visible;
	}

	.sezione-libro__layout {
		margin-top: 2.5rem;
		display: grid;
		gap: 2.5rem;
		align-items: start;
		position: relative;
		z-index: 1;
		overflow: visible;
	}

	@media (min-width: 900px) {
		.sezione-libro__layout {
			grid-template-columns: minmax(12rem, 0.9fr) minmax(0, 2.1fr);
			gap: 3rem 2.5rem;
			align-items: stretch;
		}
	}

	.sezione-libro__intro {
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.sezione-libro__stack {
		display: grid;
		gap: 1rem;
		justify-items: center;
	}

	.sezione-libro__intro .type-h2 {
		color: var(--title);
	}

	.sezione-libro__lede {
		max-width: 22rem;
		text-wrap: balance;
		color: var(--muted);
	}

	.sezione-libro__illust {
		display: none;
	}

	.sezione-libro__illust-img {
		display: block;
		width: 100%;
		height: auto;
	}

	/*
	 * Desktop: center title + lede + vine as one block.
	 * Vine is absolute (width must not grow the intro column);
	 * stack padding-bottom reserves its height for the middle align.
	 */
	@media (min-width: 900px) {
		.sezione-libro__intro {
			justify-items: start;
			align-content: center;
			text-align: left;
			min-height: 100%;
			overflow: visible;
		}

		.sezione-libro__stack {
			position: relative;
			width: 100%;
			justify-items: start;
			/* gap (3rem) + vine height: 27rem × (160/373) */
			padding-bottom: calc(3rem + 27rem * 160 / 373);
		}

		.sezione-libro__illust {
			display: block;
			position: absolute;
			right: 0;
			bottom: 0;
			width: 27rem;
			max-width: none;
			margin: 0;
			pointer-events: none;
			transform: rotate(-8deg);
			transform-origin: right center;
		}
	}

	/*
	 * Default: full-bleed horizontal rail (shell gutter breakout), books close.
	 * Two-up grid only with the desktop intro|books layout (≥900), when the
	 * editions column is actually wide enough — not at 560px mid widths.
	 */
	.sezione-libro__editions {
		--sezione-libro-peek: var(--gutter);
		/* Grows with the viewport until the ≥900 two-up grid takes over */
		--sezione-libro-card: clamp(12.5rem, 42vw, 20rem);
		/* Room for cover rotate + drop-shadow (overflow-x makes y clip too) */
		--sezione-libro-shadow-pad: 1.1rem;
		margin: 0;
		margin-inline: calc(var(--gutter) * -1);
		list-style: none;
		display: flex;
		align-items: start;
		justify-content: safe center;
		gap: 1.25rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--sezione-libro-peek);
		padding-block: var(--sezione-libro-shadow-pad);
		padding-inline: var(--sezione-libro-peek);
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		-ms-overflow-style: none;
		touch-action: pan-x;
		min-width: 0;
		width: auto;
		max-width: none;
	}

	.sezione-libro__editions::-webkit-scrollbar {
		display: none;
	}

	.sezione-libro__edition {
		flex: 0 0 var(--sezione-libro-card);
		width: var(--sezione-libro-card);
		scroll-snap-align: start;
		display: grid;
		justify-items: center;
		align-content: start;
		gap: 1rem;
		text-align: center;
		box-sizing: border-box;
	}

	/* Two-up as before — restore growth with the window from 768 */
	@media (min-width: 768px) {
		.sezione-libro__editions {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: start;
			gap: 2rem 2.5rem;
			margin-inline: 0;
			overflow: visible;
			scroll-snap-type: none;
			scroll-padding-inline: 0;
			padding-inline: 0;
			padding-block: var(--sezione-libro-shadow-pad);
			touch-action: auto;
		}

		.sezione-libro__edition {
			flex: none;
			width: auto;
			scroll-snap-align: none;
		}
	}

	.sezione-libro__cover-link {
		display: block;
		width: 100%;
		max-width: 22rem;
		margin-bottom: 0.35rem;
		text-decoration: none;
		color: inherit;
	}

	@media (min-width: 900px) {
		.sezione-libro__cover-link {
			max-width: min(100%, 26rem);
		}
	}

	.sezione-libro__cover {
		transform: rotate(-5deg);
		/* Tight shadow: left + down */
		filter: drop-shadow(-0.3rem 0.4rem 0.45rem color-mix(in oklab, var(--ink) 16%, transparent));
		transition:
			transform 700ms var(--ease-out-expo),
			filter 700ms var(--ease-out-quart);
	}

	/* Special (second / bianca): tilt the other way */
	.sezione-libro__edition:nth-child(2) .sezione-libro__cover {
		transform: rotate(5deg);
	}

	.sezione-libro__cover :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.sezione-libro__cover-link:hover .sezione-libro__cover,
	.sezione-libro__cover-link:focus-visible .sezione-libro__cover {
		transform: rotate(-2deg) translateY(-0.25rem);
		filter: drop-shadow(-0.35rem 0.5rem 0.55rem color-mix(in oklab, var(--ink) 20%, transparent));
	}

	.sezione-libro__edition:nth-child(2) .sezione-libro__cover-link:hover .sezione-libro__cover,
	.sezione-libro__edition:nth-child(2)
		.sezione-libro__cover-link:focus-visible
		.sezione-libro__cover {
		transform: rotate(2deg) translateY(-0.25rem);
	}

	.sezione-libro__edition-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: var(--font-display-weight);
		font-size: clamp(1.15rem, 1rem + 0.6vw, 1.55rem);
		line-height: 1.2;
		color: var(--title);
	}

	.sezione-libro__edition .btn {
		margin-top: 0.35rem;
	}

	.newsletter {
		margin-top: 6rem;
		padding-block: 5rem;
		border-top: 1px solid var(--line);
		text-align: center;
	}

	@media (min-width: 768px) {
		.newsletter {
			margin-top: 9rem;
			padding-block: 7rem;
		}
	}

	.newsletter__inner {
		display: grid;
		justify-items: center;
		gap: 1.25rem;
	}

	.newsletter__lede {
		max-width: 40ch;
	}

	.newsletter-form {
		width: min(100%, 28rem);
		display: grid;
		gap: 0.65rem;
		margin-top: 1rem;
	}

	.newsletter-form__status {
		margin: 0;
		font-family: var(--font-ui);
		font-size: var(--font-ui-size);
		letter-spacing: var(--font-ui-tracking);
		color: var(--muted);
	}

	.newsletter__note {
		margin-top: 0.5rem;
	}
</style>

<script define:vars={{ newsletterInvalid: t(locale, "newsletterInvalid"), newsletterThanks: t(locale, "newsletterThanks") }}>
	const form = document.getElementById("newsletter-form");
	const status = document.getElementById("newsletter-status");
	if (form && status) {
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const email = new FormData(form).get("email");
			if (!email || typeof email !== "string" || !email.includes("@")) {
				status.hidden = false;
				status.textContent = newsletterInvalid;
				return;
			}
			status.hidden = false;
			status.textContent = newsletterThanks;
			const button = form.querySelector('button[type="submit"]');
			if (button instanceof HTMLButtonElement) button.disabled = true;
		});
	}
</script>
