<script>
	const form = document.getElementById("newsletter-form");
	const status = document.getElementById("newsletter-status");

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		if (!status) return;
		status.hidden = false;
		status.textContent =
			"Grazie per l’interesse: l’iscrizione alla Newsletter arriverà a breve. Per ora non inviamo né salviamo la tua email.";
	});
</script>
