---
import { getEmDashEntry, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entry: home, cacheHint } = await getEmDashEntry("homepage", "home", {
	references: { featured_tours: true },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);

const featuredTours = home?.references?.featured_tours?.entries ?? [];
const pageTitle = home?.data.hero_title ?? siteTitle;
const pageDescription = home?.data.hero_subtitle ?? siteTagline;
---

<Base title={pageTitle} description={pageDescription}>
	{
		home ? (
			<>
				<section>
					{home.data.hero_image && (
						<div {...home.edit.hero_image}>
							<Image image={home.data.hero_image} />
						</div>
					)}
					<h1 {...home.edit.hero_title}>{home.data.hero_title}</h1>
					{home.data.hero_subtitle && (
						<p {...home.edit.hero_subtitle}>{home.data.hero_subtitle}</p>
					)}
				</section>

				<section>
					<h2 {...home.edit.tour_title}>{home.data.tour_title}</h2>
					{home.data.tour_subtitle && (
						<p {...home.edit.tour_subtitle}>{home.data.tour_subtitle}</p>
					)}

					{featuredTours.length === 0 ? (
						<p>Nessun tour in evidenza.</p>
					) : (
						<ul>
							{featuredTours.map((tour) => (
								<li>
									<a href={`/tours/${tour.id}`}>
										{tour.data.featured_image && (
											<div>
												<Image image={tour.data.featured_image} />
											</div>
										)}
										<h3>{tour.data.title}</h3>
									</a>
									{tour.data.excerpt && <p>{tour.data.excerpt}</p>}
									{(tour.data.destination ||
										tour.data.duration ||
										tour.data.price) && (
										<p>
											{[
												tour.data.destination,
												tour.data.duration,
												tour.data.price,
											]
												.filter(Boolean)
												.join(" · ")}
										</p>
									)}
								</li>
							))}
						</ul>
					)}

					{home.data.tour_cta_label && (
						<p>
							<a href="/tours" {...home.edit.tour_cta_label}>
								{home.data.tour_cta_label}
							</a>
						</p>
					)}
				</section>
			</>
		) : (
			<p>
				Homepage non configurata.{" "}
				<a href="/_emdash/admin/content/homepage">Apri l’admin</a>.
			</p>
		)
	}
</Base>
