# Generate with: npx emdash secrets generate
# Also set on the Worker: npx wrangler secret put EMDASH_ENCRYPTION_KEY
EMDASH_ENCRYPTION_KEY=

# Optional: public site origin (passkeys, CSRF, sitemaps). Prefer the workers.dev
# or custom domain you will use for setup.
# EMDASH_SITE_URL=https://spaghettiabc-staging.<account>.workers.dev
